  "foaf:name": "Collaborations for NWP Marine Ecosystem Prediction (COSMEC)",
  "sdo:name": "Collaborations for NWP Marine Ecosystem Prediction (COSMEC)",
  "sdo:description": "Recognizing that the global warming has been driving widespread ecosystem shifts, threatening biodiversity, fisheries and coastal communities, the COSMEC aims to rapidly advance our understanding of the dynamics of marine ecosystems and their response to environmental stressors in the Northwest Pacific Ocean, by integrating ocean observations (e.g., Biogeochemical (BGC) Argo float), environmental DNA (eDNA) and advance data science and AI-based methods. These innovations will significantly expand the capacity of ocean science to deliver biological and ecosystem-level data, complementing traditional physical and chemical oceanographic parameters. By contributing real-time, high-resolution data to global databases and Earth System Models (ESMs), COSMEC will support evidence-based marine policy and resource management. The COSMEC also emphasizes capacity building, stakeholder engagement, science-policy-society interface, and collaboration among WESTPAC Member States.",
  "sdo:location": "Thailand",
  "sdo:identifier": "UN46",
  "sdo:url": "https://oceandecade.org/actions/collaborations-for-nwp-marine-ecosystem-prediction-comec/",
  "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
  "sdo:parentOrganization": {
    "@type": "sdo:Organization",
    "sdo:name": "IOC Sub-Commission for the Western Pacific (WESTPAC), Advanced Institute for Marine Ecosystem Change (WPI-AIMEC), Tohoku University &amp; JAMSTEC"
  },
