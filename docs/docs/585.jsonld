  "foaf:name": "“Deep Blue Voyager 2035” Global Ocean Expedition",
  "sdo:name": "“Deep Blue Voyager 2035” Global Ocean Expedition",
  "sdo:description": "The “Deep Blue Voyager 2035” Global Ocean Expedition is a ten-year Decade Contribution supporting scientific discovery, technological innovation, ocean literacy, and international cooperation. By mobilizing the collective strength of society, it aims to advance frontier ocean research, catalyse intelligent ocean technologies, foster ocean literacy, and train future ocean leaders. Providing vessel resources and operational support, the project bridges science, industry, and the public, contributing to sustainable ocean development and a global community with a shared future for the ocean.",
  "sdo:location": "China",
  "sdo:identifier": "585",
  "sdo:url": "https://oceandecade.org/actions/deep-blue-voyager-2035-global-ocean-expedition/",
