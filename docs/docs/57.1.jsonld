  "foaf:name": "BlueActionAA",
  "sdo:name": "BlueActionAA",
  "sdo:description": "BlueActionAA empowers coastal and inland communities across the Atlantic and Arctic regions to co‑design, implement and scale ocean and freshwater restoration solutions. The initiative supports community‑led actions that restore ecosystems and biodiversity, reduce pollution, and strengthen climate resilience, while advancing a fair and carbon‑neutral blue economy. Through targeted cascading grants, technical assistance and capacity development, BlueActionAA helps local actors move from ideas to implementation and from pilots to scalable solutions. The initiative creates clear pathways from science and local knowledge to decision‑making by supporting policy implementation and strengthening collaboration between communities, scientists, public authorities and other ocean stakeholders. BlueActionAA contributes directly to the goals of the UN Ocean Decade and the EU Mission Ocean by enabling inclusive, solutions‑oriented action that delivers measurable environmental and societal impact.",
  "sdo:location": "Ireland",
  "sdo:identifier": "57.1",
  "sdo:url": "https://oceandecade.org/actions/blueactionaa/",
  "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
  "sdo:parentOrganization": {
    "@type": "sdo:Organization",
    "sdo:name": "Marine Institute, Ireland"
  },
  "sdo:keywords": [
    {
      "@type": "sdo:DefinedTerm",
      "sdo:name": "Decade Contribution",
      "sdo:description": "A Contribution is a one-off standalone initiative (such as an awareness-raising event, a scientific workshop, a training opportunity or a publication). It enables a Decade Programme or Project, or directly contributes to a Decade Challenge.",
      "sdo:inDefinedTermSet": {
        "@type": "sdo:DefinedTermSet",
        "sdo:name": "UN Ocean Decade Action types.",
        "sdo:description": "A definition of the types of Decade Action."
      }
    }
  ]
