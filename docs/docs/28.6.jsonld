  "foaf:name": "SEA2SEE",
  "sdo:name": "SEA2SEE",
  "sdo:description": "Current seafood traceability tools and services have the potential to take advantage of novel blockchain technologies to obtain a wide range of data making sustainable seafood practices more visible to consumers. Sea2See project fills in existing seafood traceability gaps through the development of an innovative end-to-end blockchain model, and both professional and consumer applications to increase trust and social acceptance of sustainably fished and farmed seafood. The project will provide technological solutions to answer the need for a valuable source of data collected throughout the whole seafood value chain, verified and covering inputs from diverse groups of stakeholders.",
  "sdo:location": "Spain",
  "sdo:identifier": "28.6",
  "sdo:url": "https://oceandecade.org/actions/sea2see/",
  "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
