    {
      "@id": "https://purl.org/oceandecade/decadeactions/37.7",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Digital REconstruction of Abyssal habitat Map",
      "sdo:name": "Digital REconstruction of Abyssal habitat Map",
      "sdo:description": "The DREAM initiative, in sync with the UN's Ocean Decade and Digital DEPTH, targets deep-sea habitats like seamounts and ridges. It seeks to boost observation tech, streamline data processing, and innovate with AI for accurate seafloor mapping. DREAM's goals include: (1) enhancing observation systems with underwater vehicles for detailed deep-sea monitoring; (2) building a data fusion platform using global and local data to craft AI tools; (3) setting up a standardized platform for versatile habitat mapping; and (4) offering public services like ocean modeling. The outcomes will enrich public knowledge and marine science.",
      "sdo:location": "China",
      "sdo:identifier": "37.7",
      "sdo:url": "https://oceandecade.org/actions/digital-reconstruction-of-abyssal-habitat-map/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
