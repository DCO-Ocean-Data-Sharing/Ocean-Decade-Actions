    {
      "@id": "https://purl.org/oceandecade/decadeactions/101.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "SubRacing Series",
      "sdo:name": "SubRacing Series",
      "sdo:description": "The SubRacing Series engages people with the ocean through an innovative underwater sport that combines fun, exploration, and science. By racing delicate submersibles, participants and audiences contribute to data collection for mapping, digital twins, and ocean monitoring, while fostering recreation, marine appreciation, environmental stewardship, and pathways into blue-economy careers—all with a focus on inspiring the next generation.",
      "sdo:location": "Ireland",
      "sdo:identifier": "101.9",
      "sdo:url": "https://oceandecade.org/actions/subracing-series/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Submarine Racing Series"
      },
      "sdo:keywords": [
