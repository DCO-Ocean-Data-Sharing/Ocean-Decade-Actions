    {
      "@id": "https://purl.org/oceandecade/decadeactions/117.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "TWILIGHTED",
      "sdo:name": "TWILIGHTED",
      "sdo:description": "TWILIGHTED is a Horizon Europe Twinning project that seeks to revolutionize deep-sea research, development and innovation (RD&I) in Portugal, ultimately benefiting all of Europe. Collaborating closely with GEOMAR (Germany) and NTNU (Norway), TWILIGHTED aims to transform MARE-Madeira / ARDITI (Madeira, Portugal) into a global hub for deep-sea RD&I. Using innovative, lower-cost and more accessible tools; capitalizing on Madeira's proximity to deep waters; and welcoming collaborations from across countries, institutes and sectors, TWILIGHTED will help accelerate our global understanding of the ocean and its essential role in sustaining life on earth.",
      "sdo:location": "Portugal",
      "sdo:identifier": "117.9",
      "sdo:url": "https://oceandecade.org/actions/twilighted/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "MARE-Madeira (ARDITI/UMa)"
      },
