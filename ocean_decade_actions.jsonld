    {
      "@id": "https://purl.org/oceandecade/decadeactions/20.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Blue Carbon Canada",
      "sdo:name": "Blue Carbon Canada",
      "sdo:description": "Blue carbon ecosystems (BCE) are increasingly recognized as carbon reservoirs and potential natural climate solutions. Yet, despite having the world's longest coastline, Canada has yet to account for the carbon value of its BCEs (salt marshes, seagrass meadows, kelp forests, seabeds) in its marine protected areas or climate solutions portfolio. Blue Carbon Canada, a partnership between Canadian universities, government, and eNGOs, is working to: 1) quantify the current and future carbon sequestration potential of coastal vegetated BCEs under climate change and land use change; 2) determine mobile bottom fishing impacts on seabed sediment carbon storage; 3) assess the economic value and the biodiversity and ecosystem services of Canada’s BCEs; 4) prioritize Canada’s BCEs for new protections and restoration to maximize benefits; and 5) mobilize this new knowledge to end-users  to inform new climate-smart conservation, restoration, and management measures for Canada’s blue carbon.",
      "sdo:location": "Canada",
      "sdo:identifier": "20.8",
      "sdo:url": "https://oceandecade.org/actions/blue-carbon-canada/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "University of Victoria"
      },
      "sdo:keywords": [
        {
