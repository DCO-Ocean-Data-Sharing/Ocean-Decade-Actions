    {
      "@id": "https://purl.org/oceandecade/decadeactions/63.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Protecting Africa's Marine Ecosystems",
      "sdo:name": "Protecting Africa's Marine Ecosystems",
      "sdo:description": "The project seeks to enhance marine ecosystem resilience in Africa by addressing pollution, fostering biodiversity conservation, and supporting sustainable marine economies. It will emphasize local capacity-building, data-sharing, and collaboration across stakeholders, including governments, NGOs, and indigenous communities.",
