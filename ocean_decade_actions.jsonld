      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/584",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Bow Seat's True Blue Fellowship",
      "sdo:name": "Bow Seat's True Blue Fellowship",
      "sdo:description": "Each year, the True Blue Fellowship, funded and managed by Bow Seat, provides peer mentorship, capacity building, and funding of up to $2,500 USD for at least 10 youth-led projects that address ocean, waterways, and/or climate change issues in their local communities through a creative arts lens. Projects must utilize the creative arts as the primary method for awareness and/or action; co-create with and engage others in the local community; and have a tangible impact on the local community and environment. The Fellowship is open to youth worldwide ages 13-24 including individuals or classes, groups, clubs, or organizations. Projects must be new or emerging (no older than two years old). If selected, Fellows receive funding; access to a community of other Fellows and Capacity Building Programs; and mentorship and support from the Future Blue Youth Council and Bow Seat Staff.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "584",
      "sdo:url": "https://oceandecade.org/actions/bow-seats-true-blue-fellowship/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Bow Seat: Creative Action for Conservation"
      },
