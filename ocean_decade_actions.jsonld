    {
      "@id": "https://purl.org/oceandecade/decadeactions/151.2",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Great Lakes Water Quality Agreement (Ocean Dumping Management)",
      "sdo:name": "Great Lakes Water Quality Agreement (Ocean Dumping Management)",
      "sdo:description": "The principal goal of GLWQA is the restoration and maintenance of the chemical, physical, and biological integrity of the Great Lakes ecosystem. The Agreement has been updated over time based on advancing science with a broadened approach to addressing the many issues impacting the lakes and that take the entire ecosystem, including people and communities into consideration.  In 2012, after extensive review and consultation, Canada and the United States amended the Agreement and expanded their commitment to address issues facing the lakes through nine specific objectives and ten annexes.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "151.2",
      "sdo:url": "https://oceandecade.org/actions/great-lakes-water-quality-agreement-ocean-dumping-management/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Canada-United States Collaboration for Great Lakes Water Quality"
      },
      "sdo:keywords": [
