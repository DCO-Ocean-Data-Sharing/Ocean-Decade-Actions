      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/16.7",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "North Atlantic Carbon Observatory",
      "sdo:name": "North Atlantic Carbon Observatory",
      "sdo:description": "A multinational platform to deliver comprehensive, sustained and integrated ocean carbon measurements to improve climate forecasts and support accountable marine carbon dioxide removal. To achieve these outcomes, the North Atlantic Carbon Observatory (NACO) will link intergovernmental agencies, industry, and research to deliver ocean carbon measurements at basin and climate-relevant scales. The platform will work across existing ocean observing networks, ocean technology and data providers, and with end-users to fund and operationalize required sensing needs.",
      "sdo:location": "Canada",
      "sdo:identifier": "16.7",
      "sdo:url": "https://oceandecade.org/pt/actions/north-atlantic-carbon-observatory/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Ocean Frontier Institute"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
