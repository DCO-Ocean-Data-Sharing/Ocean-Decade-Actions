    {
      "@id": "https://purl.org/oceandecade/decadeactions/142.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Centre of Excellence in Ocean Res. & Engineering",
      "sdo:name": "Centre of Excellence in Ocean Res. & Engineering",
      "sdo:description": "INESCTEC.OCEAN mission is to create in Portugal (PT), a Centre of Excellence (CoE) in Ocean Research and Engineering, synergistically addressing Marine Structures & Robotics, Ocean Energy & AI Digitalization domains; coordinated by INESC TEC (PT) with mentoring of SINTEF (Norway), along with PT leading institutions: Fórum Oceano, national Blue Economy cluster and APDL, North region Port Authority Innovation Hub. INESCTEC.OCEAN drives transnational cooperation focused on the EU/Atlantic region and different fields of application, such as offshore renewable energy and deep-sea environmental impact assessment. It was funded under the Teaming for Excellence 2023 call, to become a global reference in ocean science for the next decade. Supporting sustainable development and impacting global challenges in marine ecosystems, climate resilience, and Blue Economy. Thus, aligned with the Decade Challenges: 4, 5, 7 and 9.",
      "sdo:location": "Portugal",
      "sdo:identifier": "142.9",
      "sdo:url": "https://oceandecade.org/actions/centre-of-excellence-in-ocean-res-engineering/",
