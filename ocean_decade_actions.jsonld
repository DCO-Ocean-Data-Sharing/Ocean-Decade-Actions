    {
      "@id": "https://purl.org/oceandecade/decadeactions/148.2",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Sea Grant International",
      "sdo:name": "Sea Grant International",
      "sdo:description": "Central to the Decade is the need for stakeholders to co-develop and co-deliver transformative, multi-disciplinary ocean science while linking and aligning scalar-specific initiatives to broader priorities. However, in research programs that lack bottom-up mechanisms, important local issues are lost to larger national or subnational institutions, and needed info is never generated or not applied. Valuable research may be published, but never properly transitioned to managers and policy-makers. In addition, local and indigenous knowledge that could guide research programs is often lost in top-down models.    The National Sea Grant College Program is a proven model to engage universities, government agencies, and stakeholders acting in partnership to promote research, education, and outreach/extension related to marine issues. This project would share the model with international partners and encourage the establishment of similar programs through workshops and learning exchanges.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "148.2",
      "sdo:url": "https://oceandecade.org/actions/Sea-Grant-International/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "NOAA"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Contribution",
          "sdo:description": "A Contribution is a one-off standalone initiative (such as an awareness-raising event, a scientific workshop, a training opportunity or a publication). It enables a Decade Programme or Project, or directly contributes to a Decade Challenge.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ]
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/149.2",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Modernizing marine climate data infrastructure",
      "sdo:name": "Modernizing marine climate data infrastructure",
      "sdo:description": "This project will modernize the world's primary source of global marine climate data, the International Comprehensive Ocean Atmosphere Data Set (ICOADS). It will address longstanding impacts of large uncertainties in marine weather records arising from non-climatic artifacts as described in the 5th and 6th IPCC WG1 Assessment Reports. It builds historical ocean knowledge in support of climate and ocean prediction, supports the development of new interoperable and open-access data infrastructure, and engages with public initiatives for contributions of recovered historical marine data and for ocean education and outreach.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "149.2",
      "sdo:url": "https://oceandecade.org/actions/modernizing-marine-climate-data-infrastructure/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
