    {
      "@id": "https://purl.org/oceandecade/decadeactions/514",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "The Royal College of Art",
      "sdo:name": "The Royal College of Art",
      "sdo:description": "The Royal College of Art's vision is to partner with UNESCO and the Ocean Decade to create a world class fit-for-purpose co-design and stakeholder engagement platform. They aim to collaborate, observe, monitor, facilitate, educate, train, network and deploy the best codesign practices.",
      "sdo:location": "United Kingdom of Great Britain and Northern Ireland (UK)",
      "sdo:identifier": "514",
      "sdo:url": "https://oceandecade.org/actions/the-royal-college-of-art/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
