    {
      "@id": "https://purl.org/oceandecade/decadeactions/183",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "The Antarctic Monitoring and Assessment Programme",
      "sdo:name": "The Antarctic Monitoring and Assessment Programme",
      "sdo:description": "This programme aims to deliver a circum-Antarctic research and surveillance Programme focused on the major threats of organic contaminant pollution and climate-driven ecosystem change. Antarctica is no longer pristine, and our ability to capture change, forecast and mitigate impacts hinges on our ability to implement and coordinate effective circum-Polar surveillance measures. The Program seeks to provide scientific information on threats to the Antarctic environment, and government advice as to preventative and remedial action. The Programme represents an investment into an existing area of research capacity and excellence, and will deliver an established, international, research, logistics and policy network ready to ascend with the Programme for immediate impact",
      "sdo:location": "Australia",
      "sdo:identifier": "183",
      "sdo:url": "https://oceandecade.org/actions/The-Antarctic-Monitoring-and-Assessment-Programme/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Griffith University"
      },
