    {
      "@id": "https://purl.org/oceandecade/decadeactions/546",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Development of comprehensive tsunami software",
      "sdo:name": "Development of comprehensive tsunami software",
      "sdo:description": "This action will contribute to the UN 31 Ocean Decade Tsunami Programme. The aim of this action is to develop comprehensive tsunami calculation software that will be available free of charge on the Internet. The software will include two-dimensional shallow water equations commonly used in tsunami hazard assessment. In addition, it can calculate dispersive tsunamis. Parallelized tsunami calculations are possible on laptops as well as on supercomputers. We can predict not only seismic tsunamis, but also non-seismic tsunamis caused by, for example, submarine landslides and volcanic eruptions. User-friendly input/output interfaces are provided.",
      "sdo:location": "Japan",
      "sdo:identifier": "546",
      "sdo:url": "https://oceandecade.org/actions/development-of-comprehensive-tsunami-software/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Tokushima University"
      },
