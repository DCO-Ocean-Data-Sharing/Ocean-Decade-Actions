    {
      "@id": "https://purl.org/oceandecade/decadeactions/69.7",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Earth Observation on Deltas and Estuaries",
      "sdo:name": "Earth Observation on Deltas and Estuaries",
      "sdo:description": "The project addresses urgent environmental challenges in ecologically significant and vulnerable areas—deltas and estuaries—critical to global biodiversity, economies, and human livelihoods. Threatened by climate change, rising sea levels, and human activities, these areas face increased risks of ecological degradation and coastal hazards. The project will use cutting-edge earth observation technologies to create a long-term framework for monitoring and assessing key global estuaries and deltas. Focusing on six representative deltas—the Yangtze, Yellow, Red, Irrawaddy, Indus, and Niger—the project integrates satellite data, ground surveys, and socio-economic information to track changes, assess impacts, and develop globally applicable insights. Led by the Qingdao Institute of Marine Geology  of China Geological Survey, the project involves robust domestic and international collaboration to advance ecological monitoring and management strategies in these critical regions.",
      "sdo:location": "China",
      "sdo:identifier": "69.7",
      "sdo:url": "https://oceandecade.org/actions/earth-observation-on-deltas-and-estuaries/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Qingdao Institute of Marine Geology，China Geological Survey"
      },
