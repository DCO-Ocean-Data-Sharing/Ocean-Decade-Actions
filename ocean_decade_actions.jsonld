    {
      "@id": "https://purl.org/oceandecade/decadeactions/UN39",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Ocean Solutions in the East Asian Seas",
      "sdo:name": "Ocean Solutions in the East Asian Seas",
      "sdo:description": "The Decade Action will contribute to all Decade Objectives, by identifying key knowledge gaps and providing critical data from pilot sites like the Straits of Penang, Jiu Long Estuary, and Pari Island. Ongoing research and monitoring will generate essential data on multiple stressors, including eutrophication, pollution, and climate change impacts, helping to inform sustainable development strategies. Collaborative efforts between scientists, policymakers, and local communities will increase the capacity of ocean science to deliver actionable information for policy-making and management, ensuring that science-based solutions are integrated into local and regional conservation efforts.",
      "sdo:location": "Thailand",
      "sdo:identifier": "UN39",
      "sdo:url": "https://oceandecade.org/actions/ocean-solutions-in-the-east-asian-seas/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
