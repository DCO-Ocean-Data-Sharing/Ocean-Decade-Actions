    {
      "@id": "https://purl.org/oceandecade/decadeactions/76.6",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Climate Resilient - Marine Spatial Planning Project",
      "sdo:name": "Climate Resilient - Marine Spatial Planning Project",
      "sdo:description": "This initiative aims at supporting Pacific Island countries in their effort to develop sustainable blue economies via an MSP process. This project will initially focus on the Republic of Palau, with a regional capacity-building component to include other Pacific Island countries.   This project is fully aligned with the recently endorsed '2050 Strategy for the Blue Pacific Continent' which addresses present and future challenges faced by Pacific peoples. Pacific Islands leaders want the strategy to focus on political leadership and regionalism, people-centered development, peace and security, resource and economic development, climate change and disasters, ocean and environment, and technology and connectivity.",
      "sdo:location": "Fiji",
      "sdo:identifier": "76.6",
      "sdo:url": "https://oceandecade.org/actions/climate-resilient-marine-spatial-planning-project/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "The Pacific Community SPC"
      },
