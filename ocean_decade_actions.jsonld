    {
      "@id": "https://purl.org/oceandecade/decadeactions/36.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Transnational cooperation for diadromous fish",
      "sdo:name": "Transnational cooperation for diadromous fish",
      "sdo:description": "DiadSea project is a transnational cooperation initiative of 9 beneficiary partners and 28 associated partners from 4 European countries (Portugal, France, Spain, and Ireland) that is aimed at improving the management and conservation of diadromous migratory fish at sea in the Atlantic Area. Diadromous fish live in both fresh and saltwater, which makes it challenging to manage and protect them. They are found in the Atlantic Area, but there aren't many shared solutions to deal with the problems they face, especially with the added issues of climate change. By protecting these fish and their habitats, DiadSea will not only help the environment but also bring benefits to local communities, both economically and culturally.",
      "sdo:location": "Portugal",
      "sdo:identifier": "36.8",
      "sdo:url": "https://oceandecade.org/actions/transnational-cooperation-for-diadromous-fish/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "MARE, University of Évora"
      },
      "sdo:keywords": [
