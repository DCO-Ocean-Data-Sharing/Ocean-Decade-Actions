    {
      "@id": "https://purl.org/oceandecade/decadeactions/54.6",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Adaptive Fisheries Assessment in a Changing Ocean (SAP)",
      "sdo:name": "Adaptive Fisheries Assessment in a Changing Ocean (SAP)",
      "sdo:description": "ICATMAR's SAP has been carrying out an intensive and continuous monitoring program of the fishery resources of the Catalan coast since 2019, with the aim to provide scientific data for best management practices. Marine resources are subject to rapid changes in environmental characteristics as a consequence of climate variability. Our program allows to quickly detect changes in the distribution and abundance of species and the appearance of invasive species related to different factors, including climate change, thus proving its usefulness as a tool for the assessment of climate impacts on marine resources. All the data collected serve as the basis for stock assessment models to determine the status of exploited marine stocks. Detecting the effects of climate change on the marine resources ads up to ICATMAR's field of action which ultimate goal is achieving resilient and sustainable fisheries along the Catalan coast.",
      "sdo:location": "Spain",
      "sdo:identifier": "54.6",
      "sdo:url": "https://oceandecade.org/actions/adaptive-fisheries-assessment-in-a-changing-ocean-sap/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "ICATMAR"
      },
      "sdo:keywords": [
        {
