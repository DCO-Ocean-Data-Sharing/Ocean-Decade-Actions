    {
      "@id": "https://purl.org/oceandecade/decadeactions/86",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Values of the Ocean   - a 10 area Decade Programme for protection and sustainable use of the ocean",
      "sdo:name": "Values of the Ocean   - a 10 area Decade Programme for protection and sustainable use of the ocean",
      "sdo:description": "The goal of Values of the Ocean is to support research and innovation central for achieving the Ocean Decade's goals on ten areas: 1 Climate and environment interactions, 2 Holistic ocean governance, 3 Healthy and safe seafood for all, 4 Renewable energy from the ocean, 5 Environmentally friendly maritime transport, 6 An ocean of data, 7 Who owns the ocean?, 8 Keeping the Arctic in one piece, 9 Global ocean economy and development aid, and 10 Everyone understands the ocean.  Researchers, industry actors and public sector will be involved and cooperation between research disciplines, sectors and countries central.",
      "sdo:location": "Norway",
      "sdo:identifier": "86",
      "sdo:url": "https://oceandecade.org/actions/Values-of-the-Ocean-a-10-area-Decade-Programme-for-protection-and-sustainable-use-of-the-ocean-/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "The Research Council of Norway's Ocean Secretariat"
      },
