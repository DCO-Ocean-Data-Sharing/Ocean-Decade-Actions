    {
      "@id": "https://purl.org/oceandecade/decadeactions/36.6",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Inclusive and Responsible Marine Management",
      "sdo:name": "Inclusive and Responsible Marine Management",
      "sdo:description": "IR-MariMe develops a framework of transformative marine governance in Western Tropical and South Pacific Ocean (WTSPO) based on inclusive and responsible marine management. The framework comprises of 3 main components: legal, technical and institutional components. The legal framework provides guidance to identify and to regulate rights, restrictions and responsibilities (RRRs) of human to marine space based on social, economic and environmental characteristics of WTSPO at government and community levels. A technical framework is developed to map and to build marine cadastre and knowledge repository, which include the guidance to map 3D marine space; store maps, RRRs and the above characteristics; and provide access to marine cadastre and knowledge repository for all stakeholders. The institutional framework also provides guidance on planning and executing institutional and personal capacity building, as well as the policy, regulatory and organizational framework development in WTSPO.",
      "sdo:location": "Indonesia",
      "sdo:identifier": "36.6",
      "sdo:url": "https://oceandecade.org/actions/inclusive-and-responsible-marine-management/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Institut Teknologi Bandung (ITB)"
      },
