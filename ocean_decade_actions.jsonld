    {
      "@id": "https://purl.org/oceandecade/decadeactions/32.7",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Digital Habitat of Deep-sea and polar Fisheries",
      "sdo:name": "Digital Habitat of Deep-sea and polar Fisheries",
      "sdo:description": "Simulation of swimming organisms are the core requirements for studying the response of the marine biosphere to the evolution of deep-sea habitats. They are also cutting-edge technological means for marine fisheries research. Among them, remote sensing observation, acoustic observation, and biomarkers are the most representative implementation methods. However, due to the mobility and randomness of swimming organisms such as fish and the diversity and complexity of the morphological changes of swimming animals, the investigation and evaluation of marine fish is an international challenge compared to the observation of marine hydrological and chemical parameters. Therefore, a three-dimensional data observation system is constructed, the impact mechanism of global climate change, ocean hydrodynamic changes, and human activities on fish changes and habitat distribution is analyzed and simulated, thus achieving the digital habitat distribution of deep-sea and polar fishery",
      "sdo:location": "China",
      "sdo:identifier": "32.7",
      "sdo:url": "https://oceandecade.org/actions/digital-habitat-of-deep-sea-and-polar-fisheries/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "College of Fisheries, Ocean University of China"
      },
