    {
      "@id": "https://purl.org/oceandecade/decadeactions/84.7",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "The Future West African Marine Ecosystem",
      "sdo:name": "The Future West African Marine Ecosystem",
      "sdo:description": "FUTURO addresses key knowledge gaps in our understanding of the West African Upwelling System, an essential component of the global climate system and a vital source of marine resources for West African nations and beyond. This comprehensive scientific mission includes a concerted year-long international field campaign in the Mauritania-Senegalese upwelling region in 2028 to enhance understanding and promote sustainable management. It aims to co-design the observational campaign by integrating diverse disciplines and diverse stakeholder knowledge, thus also investigates how to benefit from such a campaign. How can we ensure that the results of this project have a significant, meaningful and lasting impact on the well-being and livelihoods of the local communities and the societies beyond? FUTURO’s goals to specify the outcomes and impacts of this large field study and spread awareness about FUTURO, create interest, foster dialogue, and build a network of stakeholders supporting it.",
      "sdo:location": "Germany",
      "sdo:identifier": "84.7",
      "sdo:url": "https://oceandecade.org/actions/the-future-west-african-upwelling-system/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "GEOMAR Helmholtz Centre for Ocean Research Kiel, co-lead IOCAFRICA"
      },
