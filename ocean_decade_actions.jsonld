    {
      "@id": "https://purl.org/oceandecade/decadeactions/33",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "NASA Sea Level Change Science Team",
      "sdo:name": "NASA Sea Level Change Science Team",
      "sdo:description": "Since 2014, the NASA Sea Level Change Science Team (N-SLCT) has been conducting interdisciplinary sea level science by collecting and analyzing observational evidence of sea level change, quantifying underlying causes and driving mechanisms, producing projections of future changes in sea level, and communicating NASA's latest discoveries to the public through the Sea Level Portal at https://sealevel.nasa.gov. N-SLCT has made progress many important problems in sea level science, resulting in a better understanding of ice sheet dynamics, ocean processes, the development of tools and assessments of mass loss impacts from ice sheets and glaciers on coastal cities, and improved representation of vertical land motion related to coastal subsidence, tectonics, and Earth's post-glacial rebound.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "33",
      "sdo:url": "https://oceandecade.org/actions/NASA-Sea-Level-Change-Science-Team/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "NASA"
      },
