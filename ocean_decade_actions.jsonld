    {
      "@id": "https://purl.org/oceandecade/decadeactions/73.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "VOA – Oceanographic Sailing Vessel",
      "sdo:name": "VOA – Oceanographic Sailing Vessel",
      "sdo:description": "The VOA - Veleiro Oceanográfico Arqueiro is a new initiative focused on developing a state-of-the-art oceanographic sailing vessel designed for long-term, multidisciplinary ocean monitoring and research. The project aims to gather high-quality oceanographic data while minimizing environmental impact, leveraging the efficiency of sailing vessels for scientific exploration. This aligns with the Ocean Decade's goal for sustainable ocean science, contributing to efforts in understanding the ocean-climate nexus, monitoring ecosystems, and ensuring ocean sustainability.",
      "sdo:location": "Brazil",
      "sdo:identifier": "73.9",
      "sdo:url": "https://oceandecade.org/actions/voa-oceanographic-sailing-vessel/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
