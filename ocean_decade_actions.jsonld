    {
      "@id": "https://purl.org/oceandecade/decadeactions/45",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Protecting the estuaries of WIO region",
      "sdo:name": "Protecting the estuaries of WIO region",
      "sdo:description": "Estuaries are important habitats that support existence of life in oceans. They are sometimes referred to as \"cradle of the sea\" due to their role as nurseries to various ocean animals. They are among fragile habitats due to dependence on salt-freshwater balance since any imbalances significantly affect the biodiversity and their ecosystems services. During the Ocean Decade, School of Aquatic Sciences and Fisheries Technology and partners aim to study the extent to which estuaries of the WIO region have been affected by anthropogenic activities and climate change with a view to coming up with feasible recommendation to protecting them.",
      "sdo:location": "Tanzania",
      "sdo:identifier": "45",
      "sdo:url": "Protecting the estuaries of the WIO region – Ocean Decade",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "School of Aquatic Sciences and Fisheries Technology  University of Dar es Salaam, Tanzania"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
