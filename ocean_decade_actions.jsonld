      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/72.1",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Coastal Sargassum Interception and Regeneration",
      "sdo:name": "Coastal Sargassum Interception and Regeneration",
      "sdo:description": "Coastal Sargassum Interception and Regeneration is a solutions-oriented Decade Project addressing recurrent sargassum influxes along tropical coastlines. It focuses on early interception near-shore or upon landing to prevent anaerobic decay, methane emissions, and coastal damage. Intercepted biomass undergoes low-impact, science-informed bioremediation to neutralize excess salinity and heavy metals, enabling safe conversion into regenerative outputs such as biochar-enriched compost for soil restoration and local livelihoods. Implemented initially in sargassum-affected regions, the project delivers scalable ocean-based solutions aligned with the Global Ecosystem for Ocean Solutions (GEOS) Programme.",
      "sdo:location": "Monaco",
      "sdo:identifier": "72.1",
      "sdo:url": "https://oceandecade.org/actions/coastal-sargassum-interception-and-regeneration/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Grogenics"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/172"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/85.1",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Tipping Points in Deltas and Protected Areas",
      "sdo:name": "Tipping Points in Deltas and Protected Areas",
      "sdo:description": "Climate change and anthropogenic activities are pushing deltas and estuarine marine protected areas toward critical ecological regime shifts. The project will employ an integrated framework of tipping point theory and geospatial models to empirically analyze historical trends in the carrying capacity of coastal ecosystems and generate multi-scenario projections. The goal is to identify key driving factors, establish robust early-warning and resilience indicators, and reveal the underlying multi-factor mechanisms of ecosystem regime shifts. The outcomes will provide both a methodological framework for ecosystem regime shift research and science-based tools to inform marine carrying capacity warnings, ecological management in globally representative deltas and marine protected areas, and land-sea spatial planning.",
      "sdo:location": "China",
      "sdo:identifier": "85.1",
      "sdo:url": "https://oceandecade.org/actions/tipping-points-in-deltas-and-protected-areas/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Zhejiang University"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/161"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/106.1",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Growing Oceans for Tongan Climate Resilience",
      "sdo:name": "Growing Oceans for Tongan Climate Resilience",
      "sdo:description": "Growing Oceans and the Kingdom of Tonga are collaborating on the science we need to leverage biological nitrogen fixation to support ocean health and climate stability in the South Pacific. By accelerating the evaluation of emerging phytoplankton “blue carbon” solutions, we can see if it is a fit for adoption as a science-based solution on the 2030 Agenda timeline. If so, the results will advance a holistic, nature-based approach to restoring open-ocean ecosystems, protecting biodiversity, and sequestering carbon at a scale relevant to global climate mitigation. For our partners and stakeholders in Tonga, this will be a timely opportunity to incorporate open-ocean nature-based solutions into their new Ocean Management Bill framework and their revised National Plan. This potential to realize Blue Economy revenue streams for this climate vulnerable nation would in turn relieve economic pressures favoring overfishing and consideration of seabed mining programs.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "106.1",
      "sdo:url": "https://oceandecade.org/actions/growing-oceans-for-tongan-climate-resilience/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Growing Oceans, an initiative of AltaSea at the Port of Los Angeles"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
