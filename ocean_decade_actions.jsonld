    {
      "@id": "https://purl.org/oceandecade/decadeactions/47.2",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Mayotte observatory for research and response",
      "sdo:name": "Mayotte observatory for research and response",
      "sdo:description": "The MARMOR project will provide the French scientific community with the mobile and cabled equipment required to advance the study of the earth deformation, seismicity, tsunamis, volcanism, and of several key environmental issues in ocean and coastal areas, by extending the on land observations capabilities into the marine domain.",
