    {
      "@id": "https://purl.org/oceandecade/decadeactions/53.6",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Making Oceanography Data Available to All",
      "sdo:name": "Making Oceanography Data Available to All",
      "sdo:description": "The main objective of the ICATMAR's SOCAT Service is to deliver reliable and up-to-date information about the marine environment. As such, it will contribute to the monitoring of climate change at sea, bolster maritime security, and aid to the management of the marine ecosystem. The proposed activities aim to enhance the marine observation system, implement a set of high-resolution simulations of ocean processes, and to boost ocean literacy among the general population.",
      "sdo:location": "Spain",
      "sdo:identifier": "53.6",
      "sdo:url": "https://oceandecade.org/actions/making-oceanography-data-available-to-all/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "ICATMAR - Government of Catalonia"
      },
      "sdo:keywords": [
