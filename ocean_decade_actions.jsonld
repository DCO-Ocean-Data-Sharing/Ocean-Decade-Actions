    {
      "@id": "https://purl.org/oceandecade/decadeactions/UN1",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Ocean Observing Co-Design - Evolving ocean observing for a sustainable future",
      "sdo:name": "Ocean Observing Co-Design - Evolving ocean observing for a sustainable future",
      "sdo:description": "This Programme will transform the ocean observing system through increased integration and innovation, creating a system co-designed with observing, modeling, and user stakeholders. This fit-for-purpose system will more effectively serve the expanding range of multidisciplinary societal needs and build essential infrastructure to demonstrate the ongoing societal value of the system.",
      "sdo:location": "France",
      "sdo:identifier": "UN1",
      "sdo:url": "https://oceandecade.org/actions/ocean-observing-co-design-evolving-ocean-observing-for-a-sustainable-future/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "The Global Ocean Observing System (GOOS) through lead sponsor IOC/UNESCO"
      },
      "sdo:keywords": [
