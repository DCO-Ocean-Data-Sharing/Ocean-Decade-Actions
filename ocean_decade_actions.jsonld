    {
      "@id": "https://purl.org/oceandecade/decadeactions/23.1",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "HARMONiSE",
      "sdo:name": "HARMONiSE",
      "sdo:description": "HARMONiSE (Hydrospatial Analytics for Resilient Marine Observation & Navigation through Innovative Science & Engagement) is a 48‑month, governance‑anchored project that will deliver a hydrospatial capability for Seychelles. It integrates Satellite‑Derived Bathymetry, autonomous surveys (USVs/AUVs), and stakeholder co‑design into a Marine Spatial Data Infrastructure and Seychelles Ocean Mapping Hub. By turning fragmented marine data into trusted hydrospatial intelligence, HARMONiSE will support marine spatial planning, conservation, climate resilience, navigation safety, and equitable blue‑economy growth. Over four phases and nine work packages, it will produce high‑resolution bathymetry, geospatial overlays, predictive planning tools, and capacity building for long‑term local ownership. The project shifts Seychelles from reactive to proactive ocean governance and creates a transferable SIDS model for hydrospatially enabled decision‑making that advances Ocean Decade and SDG goals.",
      "sdo:location": "Seychelles",
      "sdo:identifier": "23.1",
      "sdo:url": "https://oceandecade.org/actions/harmonise/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Seychelles Hydrospatial Observatory for Research and Exploration Institute"
      },
