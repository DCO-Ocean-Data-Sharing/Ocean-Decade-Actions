    {
      "@id": "https://purl.org/oceandecade/decadeactions/26.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "SSF Curriculum: Youth Voices for Fishful Futures",
      "sdo:name": "SSF Curriculum: Youth Voices for Fishful Futures",
      "sdo:description": "The SSF Guidelines Curriculum is a learning framework for youth and educators to explore, imagine, and mobilize the “Voluntary Guidelines for Securing Sustainable Small-Scale Fisheries in the Context of Food Security & Poverty Eradication” within their coastal and inland fishing communities. Co-created by educators in Peru, Nigeria, India, and Madagascar, the curriculum enables youth to participate in community-led monitoring of the implementation of the SSF Guidelines locally. Through assignments that involve students interviewing elders, photographing evidence of climate change’s impacts, and mapping women’s roles along the value chain, learners collect data about their surroundings and visualize it through participatory audiovisual storytelling approaches. Aligned with the Cultural Heritage Framework Programme (CHFP), we equip educators to cultivate ocean literacy, intergenerational learning, and sustainable fisheries governance through teacher training programs and global pilots.",
      "sdo:location": "Peru",
      "sdo:identifier": "26.8",
      "sdo:url": "https://oceandecade.org/actions/ssf-curriculum-youth-voices-for-fishful-futures/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Coast 2 Coast"
      },
