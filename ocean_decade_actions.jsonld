    {
      "@id": "https://purl.org/oceandecade/decadeactions/97.4",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Blue University of the Brazilian coast",
      "sdo:name": "Blue University of the Brazilian coast",
      "sdo:description": "The proposal \"Blue university of the Brazilian semiarid coast: Scientific outreach and Ocean literacy aims to connect a multidisciplinary and multi-institutional ocean literacy network on the semi-arid coast of Brazil and society through actions aimed at the general public, teachers, undergraduate students, environmental management agencies and decision makers, using social communication and environmental education.",
      "sdo:location": "Brazil",
      "sdo:identifier": "97.4",
      "sdo:url": "https://oceandecade.org/actions/blue-university-of-the-brazilian-coast/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Institute of Marine Sciences (LABOMAR). Federal University of Ceará (UFC)"
      },
      "sdo:keywords": [
