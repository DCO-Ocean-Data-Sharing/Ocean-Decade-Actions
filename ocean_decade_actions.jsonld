    {
      "@id": "https://purl.org/oceandecade/decadeactions/16.6",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Ocean Online - web-based information platform",
      "sdo:name": "Ocean Online - web-based information platform",
      "sdo:description": "The \"Ocean Online\" information portal is intended to provide science-based information on socially relevant marine topics, pooling the expertise of German marine research. The portal’s focus is on the sustainable use of coasts, seas, and the ocean. The portal is designed for individuals who wish to have a say and make decisions regarding the subjects of \"Ocean and climate, ecosystem services, uses, and sustainability goals\". In cooperation with the German Research Center for Artificial Intelligence (DFKI), an AI-supported semantic search function is being developed to enable users to quickly and efficiently find information that is comprehensible and needs-based.",
      "sdo:location": "Germany",
      "sdo:identifier": "16.6",
      "sdo:url": "https://oceandecade.org/actions/ocean-online-web-based-information-platform/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "The German Marine Research Alliance (DAM)"
      },
      "sdo:keywords": [
