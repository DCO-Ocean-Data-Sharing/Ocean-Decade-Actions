      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/50.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Coral Reefs Acidification Monitoring Network",
      "sdo:name": "Coral Reefs Acidification Monitoring Network",
      "sdo:description": "Our project focuses on observing and studying the acidification impacts on coral reef ecosystems in countries along the 21st Century Maritime Silk Road. Key activities include conducting large-scale observations in coral reef areas to assess current acidification levels and ecological conditions; establishing long-term observation networks through continuous monitoring at selected representative sites (both healthy and degraded reefs). Concurrently, laboratory-based acidification simulation experiments are conducted. By integrating field observation data, we analyze and predict the responses of coral reef ecosystems to ocean acidification and other stresses, proposing effective conservation and restoration strategies. We also deliver training sessions and public outreach lectures on ocean acidification to enhance scientific literacy and community engagement in addressing and mitigating its impacts on coral reef ecosystems.",
      "sdo:location": "China",
      "sdo:identifier": "50.9",
      "sdo:url": "https://oceandecade.org/actions/coral-reefs-acidification-monitoring-network/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "South China Sea Marine Survey Center, Ministry of Natural Resources"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/219"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/56.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "EO technologies for Continental Healthy Currents",
      "sdo:name": "EO technologies for Continental Healthy Currents",
      "sdo:description": "The Indian Ocean land-sea interface, a habitats for marine biodiversity and provides essential ecosystem services to millions of people depending on them for livelihoods, and cultural heritage remain polluted. Resulting to health disorders from exposure to marine pollutants, including reproductive, and immunological issues. Inequalities in ocean science capacity and capabilities impede access to and quality control of data on pollution mitigation and management, knowledge and technology transfer. EO technologies for Continental Healthy Currents project envisions to leverage on earth observation technologies, including satellite remote sensing and geographic information systems for data collection, to monitor, analyze, and respond to marine pollution. The project envisions to establish a multi-scale replicable EO monitoring system along the Indian Ocean coastline that provides an accessible, open and equitable access to data and information on pollution governance.",
      "sdo:location": "Kenya",
      "sdo:identifier": "56.9",
      "sdo:url": "https://oceandecade.org/actions/eo-technologies-for-continental-healthy-currents/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Chemichemi Foundation"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/UN36"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/58.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Pacific Islands Heritage Marine Reserve",
      "sdo:name": "Pacific Islands Heritage Marine Reserve",
      "sdo:description": "The Pacific Islands Heritage Coalition is a diverse network of elders, fishers, cultural practitioners, scientists, navigators, storytellers, nonprofit leaders, community groups, and others across the Pacific. The Coalition formed in 2014 to protect and amplify the cultural and ecological legacy of the Pacific Islands Heritage Marine National Monument (PIHMNM), which spans 1.27 million sq km. PIHMNM contains some of the last wild, healthy ocean ecosystems on the planet and is a place of great cultural significance for Indigenous Pacific Islanders. It is home to endangered and threatened wildlife, including sharks, rays, seabirds, blue whale, leatherback turtle, and deep-sea life found nowhere else. This project focuses on maintaining and expanding protections for this special area and supporting cultural, scientific, and storytelling efforts. The long-term vision is a connected, healthy Pacific where wildlife and communities thrive, and we care for the natural world as our ancestors.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "58.9",
      "sdo:url": "https://oceandecade.org/actions/pacific-islands-heritage-marine-reserve/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Pacific Islands Heritage Coalition"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/69"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/63.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Large-scale Seagrass Mapping & Management Init",
      "sdo:name": "Large-scale Seagrass Mapping & Management Init",
      "sdo:description": "Seagrass meadows provide food, livelihoods, and climate benefits for communities across the Western Indian Ocean (WIO). But limited data on seagrasses coverage remains a barrier to their conservation and management. The Large-Scale Seagrass Mapping and Management Initiative (LaSMMI) (www.lasmmi.org) is a research collaborative supported by The Pew Charitable Trusts, in partnership with the Western Indian Ocean Marine Science Association (WIOMSA), University of Southampton, and several research institutions and partners in the WIO region. Building on successful research completed in Seychelles, the LaSMMI project aims to create a field-verified seagrass map and estimate seagrass carbon stocks for Kenya, Tanzania, Mozambique, and Madagascar. LaSMMI also seeks to deliver the data needed to accelerate seagrass conservation and management, particularly through policies such as the Nationally Determined Contributions under the Paris Agreement.",
      "sdo:location": "United Kingdom of Great Britain and Northern Ireland (UK)",
      "sdo:identifier": "63.9",
      "sdo:url": "https://oceandecade.org/actions/large-scale-seagrass-mapping-management-init/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "University of Southampton"
      },
