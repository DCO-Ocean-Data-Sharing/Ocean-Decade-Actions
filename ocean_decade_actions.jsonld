    {
      "@id": "https://purl.org/oceandecade/decadeactions/196",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Urchinomics: Global Kelp Forest Restoration Sea Urchin Ranching Alliance",
      "sdo:name": "Urchinomics: Global Kelp Forest Restoration Sea Urchin Ranching Alliance",
      "sdo:description": "Climate change and overfishing of predatory species from the world's oceans have allowed sea urchins to explode in population and overgraze kelp forests, turning the once highly productive ecosystems into desert-like barrens. Without intervention, urchins will occupy the space where kelp forests stood and keep them barren for decades or even centuries.     Urchinomics is a for-profit, self-sustaining solution to ignite the ecosystem restoration effort. In partnership with divers and scientists, Urchinomics helps restore kelp forests by removing overgrazing urchins from urchin barrens, ranching them in proprietary aquaculture systems, and converting them into premium seafood to sell to consumers globally.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "196",
      "sdo:url": "https://oceandecade.org/actions/Urchinomics-Global-Kelp-Forest-Restoration-Sea-Urchin-Ranching-Alliance/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Urchinomics"
      },
