    {
      "@id": "https://purl.org/oceandecade/decadeactions/83.6",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Empower Ocean",
      "sdo:name": "Empower Ocean",
      "sdo:description": "Empower Ocean is a female empowerment and capacity building initiative that creates opportunities for local women from coral reef communities to be involved in ocean guardianship, through high-impact dive and marine conservation training.",
      "sdo:location": "United Kingdom of Great Britain and Northern Ireland (UK)",
      "sdo:identifier": "83.6",
