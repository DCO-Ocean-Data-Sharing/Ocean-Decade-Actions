      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/48.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "One Ocean, many rocky shores to monitor & restore",
      "sdo:name": "One Ocean, many rocky shores to monitor & restore",
      "sdo:description": "SARCE+ (Transformative Intertidal Decade for Rocky Shores Conservation) is a Latin America & Caribbean collaborative network advancing conservation and restoration of rocky shores, ecosystems of high biodiversity and cultural relevance that remain underrepresented in global agendas. Building on the legacy of SARCE and MBON Pole to Pole, SARCE+ integrates standardized biodiversity monitoring, eDNA, remote sensing, and socio-ecological data into open platforms to support science-based management. The action mobilizes local communities, students, and decision-makers, strengthening capacities and co-designing transformative solutions for resilient coasts. SARCE+ is officially endorsed by the Decade Programme CoastPredict, ensuring global connectivity and impact. Tangible actions include regional data mobilization, restoration pilots, educational campaigns, and policy uptake, directly addressing Ocean Decade Challenge 2 and contributing to SDGs and the CBD 2050 Vision.",
      "sdo:location": "Argentina",
      "sdo:identifier": "48.9",
      "sdo:url": "https://oceandecade.org/actions/one-ocean-many-rocky-shores-to-monitor-restore/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Museo Argentino de Ciencias Naturales Bernardino Rivadavia"
      },
      "sdo:keywords": [
