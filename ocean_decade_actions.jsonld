    {
      "@id": "https://purl.org/oceandecade/decadeactions/106.2",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "DNA-based approaches for fisheries monitoring",
      "sdo:name": "DNA-based approaches for fisheries monitoring",
      "sdo:description": "An Atlantic network for marine fish monitoring in the scope of the Atlantic Interactions, using DNA-based and other approaches. Once fully established, this network will provide broad-scale data to support scientific advise on sustainable management and conservation of fisheries resources and fish biodiversity all through the Atlantic. To accomplish these goals a partnership was established between academic, research and governmental institutions in Portugal, Cape Verde and Brazil, therefore assuring direct application of the project's research and output. The multidisciplinary project's team integrates research experts covering the full sweep of competences and scientific background involved in the project's topics, namely in DNA-based approaches for biomonitoring, ichthyoplankton identification and ecology, fish ecology and fisheries research, bioinformatics and statistics.",
      "sdo:location": "Portugal",
      "sdo:identifier": "106.2",
      "sdo:url": "https://oceandecade.org/actions/DNA-based-approaches-for-fisheries-monitoring/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Centre of Molecular and Environmental Biology (CBMA), University of Minho"
      },
