    {
      "@id": "https://purl.org/oceandecade/decadeactions/43.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Southern Ocean Microbiome and Geochemistry",
      "sdo:name": "Southern Ocean Microbiome and Geochemistry",
      "sdo:description": "Southern Ocean is one of the most important sinks of CO2 on Earth, functioning through both the biological and dissolved carbon pumps, and influence global climate and carbon cycle. As the largest upwelling system on Earth, it also serves as an essential role controlling the Earth's global biological and elemental cycles through Antarctic Circumpolar Current (ACC). Environmental factors and the interaction of bacteria and algae affect the change and succession of phytoplankton community, and biological carbon pumping process in the SO. SOMG focus on microbial life and metabolism, carbon dynamics, trace element cycles, and historical climate changes. Under global efforts, capacity-building, and inclusive co-design and collaboration, SOMG is dedicated to developing research platforms and tools, and eco-environmental indices to understand the role of the Southern Ocean on the global carbon cycle and climate.",
      "sdo:location": "China",
      "sdo:identifier": "43.9",
      "sdo:url": "https://oceandecade.org/actions/southern-ocean-microbiome-and-geochemistry/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Shanghai Jiao Tong University"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/4.6"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/47.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "A Bottle of Science to the Ocean",
      "sdo:name": "A Bottle of Science to the Ocean",
      "sdo:description": "A Bottle of Science to the Ocean is an outreach initiative designed to bridge science and society by translating oceanographic knowledge into culturally resonant, engaging micropublications. Led by the Oceanographic and Antarctic Institute of the Ecuadorian Navy (INOCAR) with the support of the Permanent Commission for the South Pacific (CPPS), the project aims to amplify public understanding of the ocean through narratives, visuals, and voices rooted in local and traditional knowledge systems. It combines scientific communication, community engagement, and educational innovation in line with the Ocean Decade’s ocean literacy vision and cultural heritage priorities. Focused on Ecuador’s maritime jurisdiction, including the Galapagos Islands and Ecuador’s scientific expeditions to the Antarctic, the initiative is designed to be mobile-accessible and low-cost, targeting coastal populations and aiming to scale regionally across the Southeast Pacific.",
      "sdo:location": "Ecuador",
      "sdo:identifier": "47.9",
      "sdo:url": "https://oceandecade.org/actions/a-bottle-of-science-to-the-ocean/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Instituto Oceanográfico y Antártico de la Armada"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
