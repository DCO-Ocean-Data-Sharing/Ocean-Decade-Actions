    {
      "@id": "https://purl.org/oceandecade/decadeactions/515",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "J-DESC-IODP Literacy initiative",
      "sdo:name": "J-DESC-IODP Literacy initiative",
      "sdo:description": "Through Scientific Drilling, scientists have obtained underground samples and mined various important knowledge on Natural Hazards including Earthquakes and Tsunamis, Climate Change, and Volcanic Eruptions. For example, sediment cores obtained by scientific ocean drilling have contributed as paleoclimate archives to reveal the processes and mechanisms that drive global climate change. The international framework of IODP (International Ocean Discovery Program), has been registered as a Contribution of Decade Action. As the Japanese representative scientific community of IODP, J-DESC (Japan Drilling Earth Science Consortium: J-DESC, established in 2003) will contribute to the UN Decade of Ocean Science promotion as one of the “platforms” providing communication among scientists, students, and the general public. J-DESC has actively engaged in hypothesis-driven, bottom-up, and international science collaborations through open communication with international colleagues. J-DESC has been promoting its science by organizing workshops for scientists and students, and symposiums for wider members of societies including the general public, decision-makers, children, etc. Also, J-DESC has been providing hands-on training courses to early career ocean professionals (ECOPs) and students who are not familiar with the scientific ocean drilling and its science. In 2019, J-DESC made this core school open to Asian societies as an international core school and received nine international students and ECOPs as trainees. In addition, J-DESC recently started a new program for providing graduate students with the opportunity to participate in scientific drilling expeditions along with scientists for opening the eyes of students with real experience to get on board. About 10 days of expedition participation is open to graduate students in Japanese universities. Nine students got on board with this new program in 2021, the real experiences were extremely stimulating to the students, and they enhanced their literacy of ocean sciences. Above examples are all J-DESC’s established and active paths to the wide range of stakeholders in Japan and Asia, J-DESC aims to expand its function to be a promotion/communication body (i.e. \"platform”) for the UN Decade of Ocean Sciences in the Decade Contributions by facilitating public scientific communication, as well as promoting peer-to-peer collaboration and mentoring. J-DESC will seek to further expand its activity to advance literacy of ocean science in general for the next decade.",
      "sdo:location": "Japan",
      "sdo:identifier": "515",
      "sdo:url": "https://oceandecade.org/actions/J-DESC-IODP-Literacy-initiative/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Japan Drilling Earth Science Consortium (J-DESC)"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Contribution",
          "sdo:description": "A Contribution is a one-off standalone initiative (such as an awareness-raising event, a scientific workshop, a training opportunity or a publication). It enables a Decade Programme or Project, or directly contributes to a Decade Challenge.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ]
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/516",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Royal Society Ocean Science Policy Programme",
      "sdo:name": "Royal Society Ocean Science Policy Programme",
      "sdo:description": "The Royal Society’s Science in Public Life programme is launching a new workstream in November 2022: the Ocean Science Policy programme. The programme aims to facilitate the transfer of knowledge between academia and policy. The programme will provide a platform for early career researchers (ECRs) and early career ocean professionals (ECOPs) in marine science to understand the broader utility of their work, notably in policy making, and enhance their networks both with other academics and with policy makers. Through the programme we will offer ECRs insight into how their work can influence science policy, and create opportunities for the identification, generation, and use of critical knowledge to meet the goals of the Ocean Decade. The programme also aims to provide policy makers with access to expertise to inform ocean policy in the context of the Ocean Decade.",
      "sdo:location": "United Kingdom of Great Britain and Northern Ireland (UK)",
      "sdo:identifier": "516",
      "sdo:url": "https://oceandecade.org/actions/Royal-Society-Ocean-Science-Policy-Programme/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "The Royal Society"
      },
      "sdo:keywords": [
        {
