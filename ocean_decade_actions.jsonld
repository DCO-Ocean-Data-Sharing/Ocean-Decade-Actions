    {
      "@id": "https://purl.org/oceandecade/decadeactions/43.1",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Advancing in situ imaging to study Carbon Storage",
      "sdo:name": "Advancing in situ imaging to study Carbon Storage",
      "sdo:description": "Photosynthesis in the ocean converts ~100 Gt CO2 into organic matter yearly, of which 5-15% sinks to the deep ocean. The depth to which this matter sinks influences ocean carbon storage, as changes in this flux attenuation depth drive atmospheric pCO2 variations of up to 200 ppm. Attempts to maps flux attenuation globally have yielded contrasting patterns, blocking our understanding of ocean carbon storage and our ability to predict it. ANTICS uses an innovative synthesis of cutting-edge in situ imaging, machine learning and novel data analyses to mechanistically understand flux attenuation. Using state-of-the-art imaging technologies, we measure size, distribution and composition of particles across the Atlantic. We develop particle size spectra analyses to quantify the processes causing flux attenuation and statistically link these to environmental data to determine dominant controls under varying conditions.",
      "sdo:location": "United Kingdom of Great Britain and Northern Ireland (UK)",
      "sdo:identifier": "43.1",
      "sdo:url": "https://oceandecade.org/actions/advancing-in-situ-imaging-to-study-carbon-storage/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "National Oceanography Centre"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/189"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/45.1",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Centre for Marine Restoration",
      "sdo:name": "Centre for Marine Restoration",
      "sdo:description": "The Center for Marine Restoration (SMR) is a major Bellona initiative addressing the collapse of 5,000 km² of kelp forest along Northern Norway’s coast, now replaced by sea urchin barrens due to past overfishing of predators such as cod and wolffish. This loss has reduced carbon storage, biodiversity, and annual fish stocks by around 50,000 tons. SMR will drive large-scale ecosystem recovery by coordinating research, technology, and documentation of restoration impacts. It will function as shared infrastructure for researchers, students, startups, volunteers, and industry, turning an ecological crisis into sustainable business and climate opportunities.",
      "sdo:location": "Norway",
      "sdo:identifier": "45.1",
      "sdo:url": "https://oceandecade.org/actions/centre-for-marine-restoration/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "The Bellona Foundation"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/17"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/46.1",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Mapping ecological substrates in the global ocean",
      "sdo:name": "Mapping ecological substrates in the global ocean",
      "sdo:description": "Despite decades of marine surveys and research, systemic understanding of seafloor habitats remains limited. Lack of a unified ecological substrate map hinders exploration of seafloor processes. The Mapping Ecological Substrates in the Global Ocean (MAPS-GO) project aims, through international collaboration, to create a digital global ocean ecological substrate map and database by 2030 that will illustrate distribution patterns, evolutionary trends of the seafloor material and its ecological impacts. MAPS-GO will establish a universal classification of ecological substrates and data standards, integrating public and unlocked legacy data. MAPS-GO will also analyze archived samples and participate in ongoing marine bottom investigations, boost mapping efficiency using advanced technologies including machine learning, intelligent inversion and modeling. This initiative empowers resource development, ecosystem protection, and governance, directly advancing the UN Ocean Decade vision.",
      "sdo:location": "China",
      "sdo:identifier": "46.1",
      "sdo:url": "https://oceandecade.org/actions/mapping-ecological-substrates-in-the-global-ocean/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "First Institute of Oceanography, Ministry of Natural Resources, China"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
