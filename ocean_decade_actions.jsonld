    {
      "@id": "https://purl.org/oceandecade/decadeactions/27.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Bluer Africa",
      "sdo:name": "Bluer Africa",
      "sdo:description": "This project aims to build coastal resilience across Africa by implementing a comprehensive set of interventions to address the impacts of climate change on ocean human health through Ocean literacy, community-based adaptation strategies, and coastal infrastructure improvements, prioritizing vulnerable coastal communities and ecosystems. To empower coastal communities across the continent adopt sustainable practices that enhance the health of marine ecosystems and foster equitable economic development by focusing on education, public engagement, and inclusivity, to combat climate change and address systemic inequalities while promoting a sustainable ocean economy as a vital pillar of Africa's future prosperity",
      "sdo:location": "Nigeria",
      "sdo:identifier": "27.8",
      "sdo:url": "https://oceandecade.org/actions/bluer-africa/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Bluer Coast Community Development Initiative"
      },
