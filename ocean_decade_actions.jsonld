      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/156.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Actions for Climate Transition in Aquaculture",
      "sdo:name": "Actions for Climate Transition in Aquaculture",
      "sdo:description": "ActFast aims to identify, validate, and demonstrate climate change adaptation and mitigation solutions tailored for European aquaculture, alongside opportunities to increase sustainable production. Targeting regions where aquaculture is deeply integrated into the socio-economic fabric, the project will map climate hazards across the Mediterranean Sea, Deltas, Central-Eastern European inland waters, and North-East Atlantic Ocean, utilizing historical data, predictions, stakeholder insights, and satellite surveys. Integrating this comprehensive data analysis, the project will develop a user-friendly early warning system for the Mediterranean region empowering aquafarmers to proactively manage and mitigate climate risks. ActFast will promote the development of fast and replicable climate solutions for marine, transitional, and freshwater aquaculture by integrating climate prediction models with targeted solutions in four target regions.",
      "sdo:location": "Italy",
      "sdo:identifier": "156.9",
      "sdo:url": "https://oceandecade.org/actions/actions-for-climate-transition-in-aquaculture/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Alma Mater Studiorum - University of Bologna"
      },
