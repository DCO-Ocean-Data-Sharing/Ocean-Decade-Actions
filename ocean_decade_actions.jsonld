    {
      "@id": "https://purl.org/oceandecade/decadeactions/15.6",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Streategic Management of Ghost Gear in Coastal Land",
      "sdo:name": "Streategic Management of Ghost Gear in Coastal Land",
      "sdo:description": "This initiative addresses the environmental threat posed by improperly disposed fishing gear, which pollutes oceans and endangers marine ecosystems. The project aims to unite efforts in developing comprehensive solutions for the collection, processing, and responsible disposal of marine-retrieved-plastics. The creation of Ocean Plastic Depots serves to expand existing networks, enhance infrastructure, and provide training to coastal communities.  Central to the project are collection programs designed to retrieve abandoned, lost, or discarded fishing gear (ALDFG) from shorelines, oceans, and marine industrial areas. An industrial-scaled hub will be established for the collection, processing, and distribution of ALDFG materials in collaboration with coastal communities. This includes supporting community partners engaged in ghost gear retrieval and creating a sustainable methodology for long-term stewardship, involving transportation and recycling programs for financial sustainability.",
      "sdo:location": "Canada",
      "sdo:identifier": "15.6",
      "sdo:url": "https://oceandecade.org/fr/actions/strategic-management-of-ghost-gear-in-coastal-land/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Ocean Legacy Foundation"
      },
