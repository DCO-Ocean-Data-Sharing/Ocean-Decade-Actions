    {
      "@id": "https://purl.org/oceandecade/decadeactions/7.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Sustainable Ocean Resilience for African Community",
      "sdo:name": "Sustainable Ocean Resilience for African Community",
      "sdo:description": "The Sustainable Ocean Resilience for African Communities (SORAC) will enhance community resilience in African coastal areas by providing early warning systems, promoting ocean literacy, and strengthening adaptive capacities. Our goal is to integrate indigenous knowledge with innovative science for sustainable ocean risk management.",
      "sdo:location": "Nigeria",
