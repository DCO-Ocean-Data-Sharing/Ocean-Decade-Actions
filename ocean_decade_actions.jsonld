      "foaf:name": "Ocean Literacy Educational Program (Ocean health and protection)",
      "sdo:name": "Ocean Literacy Educational Program (Ocean health and protection)",
      "sdo:description": "Creation of an educational sistem for ocean literacy in a public-private partnership, involving academia, civil society, religious institutions.   Training for all layers of society.   Dedicated to legislation that makes education for health and protection of the ocean mandatory",
      "sdo:location": "Cabo Verde",
