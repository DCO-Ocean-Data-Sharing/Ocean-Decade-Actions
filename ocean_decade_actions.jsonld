      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/21.6",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "SeaKeepers' Seabed 2030 Project (SeaKeepers CSB)",
      "sdo:name": "SeaKeepers' Seabed 2030 Project (SeaKeepers CSB)",
      "sdo:description": "The International SeaKeepers Society is a Trusted Node for the International Hydrographic Organization, assisting Seabed 2030 fulfill their goal of mapping the entire ocean floor by the year 2030. SeaKeepers' mission is to promote oceanographic research, conservation, and education through direct involvement with the yachting community. We enable the yachting community to take full advantage of their unique potential to advance marine sciences and raise awareness about global ocean issues. Our Citizen Science team has installed bathymetric loggers on over 90 vessels and utilizes our connections with the boating community to scale this project and reach the common goal.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "21.6",
      "sdo:url": "https://oceandecade.org/actions/seakeepers-seabed-2030-project-seakeepers-csb/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "The International SeaKeepers Society"
      },
      "sdo:keywords": [
