    {
      "@id": "https://purl.org/oceandecade/decadeactions/534",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Mediterranean Green Shipping Centre of Excellence",
      "sdo:name": "Mediterranean Green Shipping Centre of Excellence",
      "sdo:description": "Our proposed Decade Action is the Mediterranean Centre of Excellence on Green Shipping, led by the World Ocean Council. The Centre will be a hub for the Mediterranean Green Shipping Community, fostering connections among stakeholders, promoting innovation, and developing legacy pathways. It will facilitate Green Shipping start-ups to connect with the wider investment ecosystem in the Mediterranean, ensuring cross-sectoral value. This initiative will promote sustainable practices in maritime transport and stimulate economic growth and innovation in the region.",
      "sdo:location": "France",
      "sdo:identifier": "534",
      "sdo:url": "https://oceandecade.org/actions/mediterranean-green-shipping-centre-of-excellence/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "World Ocean Council"
      },
