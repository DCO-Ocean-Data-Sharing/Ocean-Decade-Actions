      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/61.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Sediment upheaval and negative carbon emissions",
      "sdo:name": "Sediment upheaval and negative carbon emissions",
      "sdo:description": "By applying an interdisciplinary research approach and combining multi-dimensional observations with numerical simulations, this project elucidates the sediment diffusion process into seawater and the distribution patterns of suspended sediments. It reveals the coupling mechanism between water-sediment dynamics and carbon emissions in estuaries and adjacent sea areas, identifying spatio-temporal changes in carbon emissions constrained by the water-sediment interaction process. To clarify the main controlling factors of carbon emissions in the subaqueous delta of estuaries, this study provides scientific support for exploring the sink enhancement potential of estuaries and improving their sink enhancement schemes.",
      "sdo:location": "China",
      "sdo:identifier": "61.8",
      "sdo:url": "https://oceandecade.org/actions/sediment-upheaval-and-negative-carbon-emissions/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "China University of Petroleum"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/8.2"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/64.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Empowering Communities through Ocean Literacy",
      "sdo:name": "Empowering Communities through Ocean Literacy",
      "sdo:description": "This project aims to promote ocean literacy among the coastal communities of Bangladesh, focusing on enhancing their understanding of the ocean’s vital role in environmental, economic, and social well-being. The goal is to equip these communities with the knowledge and tools to engage in sustainable marine resource management, while fostering a deeper, more emotional connection to the ocean. By integrating traditional knowledge with scientific approaches, this project will build a strong foundation for ocean conservation and sustainable practices in the Bay of Bengal.",
      "sdo:location": "Bangladesh",
      "sdo:identifier": "64.8",
      "sdo:url": "https://oceandecade.org/actions/empowering-communities-through-ocean-literacy/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Bangladesh Centre for Ocean Law and Policy (BCOLP)"
      },
      "sdo:keywords": [
