    {
      "@id": "https://purl.org/oceandecade/decadeactions/48.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "An observatory of the North Atlantic Gateway",
      "sdo:name": "An observatory of the North Atlantic Gateway",
      "sdo:description": "Creating synergies between the Fram Strait LTER site \"Hausgarten\" and the Icelandic benthic inventory gained from BIOICE (Benthic Invertebrates of Icelandic Waters 1992-2004) and IceAGE  (Icelandic marine Animals: Genetics and Ecology since 2011) is the goal of this international 5-year project ALONGate (A long-term observatory of the North Atlantic  Gateway to the Arctic Ocean). The project focusses on deep-sea benthos, its  connectivity, and anthropocene impact on Vulnerable Marine Ecosystems (VMEs). The project and its intenational network se used as a “kickoff” to strengthen collaboration and promote the importance of the region, the “North Atlantic Gateway to the Arctic” on a higher international level.",
      "sdo:location": "Germany",
      "sdo:identifier": "48.8",
      "sdo:url": "https://oceandecade.org/actions/an-observatory-of-the-north-atlantic-gateway/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
