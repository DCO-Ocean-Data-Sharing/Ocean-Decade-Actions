    {
      "@id": "https://purl.org/oceandecade/decadeactions/18.3",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Bay of Bengal Large Marine Ecosystem Project II (BOBLME II)",
      "sdo:name": "Bay of Bengal Large Marine Ecosystem Project II (BOBLME II)",
      "sdo:description": "The  Bay of Bengal large marine ecosystem project addresses issues related to the overexploitation of marine living resources, the degradation and loss of critical habitats and water pollution. The BOB  countries have agreed to work together and collaborate in the implementation of the BOBLME Strategic Action Programme (SAP) through the collaboration of the project’s Executing Agencies. The BOBLME is innovative with a strong focus on how fishery and management,  habitats and livelihoods interest. The project also focuses on traditional fishing stocks but bringing innovation through the ecosystem approach to fishery management (EAFM) in Marine Managed Areas (MMAs) for rebuilding fish stocks to sustain livelihoods while achieving positive Biodiversity outcomes. It directly supports women in the fisheries sector, directly addressing their past exclusion of fisheries development programs. The project will also have a focus on marine pollution and reduction of plastics from fishing.",
      "sdo:location": "Thailand",
      "sdo:identifier": "18.3",
      "sdo:url": "https://oceandecade.org/actions/bay-of-bengal-large-marine-ecosystem-project-ii-boblme-ii/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
