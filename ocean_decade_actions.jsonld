    {
      "@id": "https://purl.org/oceandecade/decadeactions/73.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Sustainable Ocean Management Program",
      "sdo:name": "Sustainable Ocean Management Program",
      "sdo:description": "EU Agendas stress integrating Maritime Cultural Heritage (MCH) management, Marine Spatial Planning (MSP), and Climate Science (CS), although there are currently no educational forums combining training in these skills. Therefore, the objective of the Sustainable Ocean Management program is to mitigate this gap by contributing to the development of future ocean professionals and their knowledge of these practices within and beyond the higher education environment. SOM develops a toolkit to integrate MCH management, MSP and CS into higher education, holds three summer schools to implement, test, and refine the toolkit, and engages stakeholders within and beyond the partnership via a variety of forums and media. The result of the SOM will be an international cohort of early-career professionals engaged in innovative Ocean research, sustainability challenges, and best practices in holistic resource management. Overall, SOM is a baseline that meets the demands of the EU and national agendas",
      "sdo:location": "Germany",
      "sdo:identifier": "73.8",
      "sdo:url": "https://oceandecade.org/actions/sustainable-ocean-management-program/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "COAST Center, University of Oldenburg"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
