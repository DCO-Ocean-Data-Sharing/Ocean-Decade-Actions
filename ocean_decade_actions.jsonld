    {
      "@id": "https://purl.org/oceandecade/decadeactions/12.5",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Rewilding the Oceans with Giant Kelp (Kelp Blue)",
      "sdo:name": "Rewilding the Oceans with Giant Kelp (Kelp Blue)",
      "sdo:description": "We grow giant kelp forests (macrocystis) at scale to boost the health of the oceans. Giant Kelp one of the fastest growing organisms on the planet, growing up to 50 cm per day and has the ability to draw down more CO2 than terrestrial forests. Growing kelp requires no fertilisers, no pesticides, no land and no fresh water and Kelp forests boosting marine biodiversity and providing habitats for innumerable marine organisms.    We harvest only the kelp canopy to produce sustainable products in agri-foods, fertilisers, pharmaceuticals, textiles that foster a low carbon economy. Over the next 4 years we will scale our operations to create profitable nature-based solutions that will help reverse climate change.",
      "sdo:location": "Namibia",
      "sdo:identifier": "12.5",
      "sdo:url": "https://oceandecade.org/actions/rewilding-the-oceans-with-giant-kelp/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Kelp Blue"
      },
