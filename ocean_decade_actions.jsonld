    {
      "@id": "https://purl.org/oceandecade/decadeactions/589",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Com-Vida CAIC Project",
      "sdo:name": "Com-Vida CAIC Project",
      "sdo:description": "The Com-Vida CAIC Project promotes environmental awareness and ocean literacy among children and adolescents at the Ayrton Senna da Silva Integrated Center for Child and Adolescent Support in Balneário Camboriú, Brazil. Grounded in UNESCO’s Education for Sustainable Development framework, the project engages students as active agents in building a sustainable future through collective actions such as waste reduction, recycling campaigns, and monitoring the river-to-ocean pathway. By integrating science, citizenship, and creativity, Com-Vida CAIC fosters ecological thinking and community engagement, connecting local initiatives to the global goals of the United Nations Decade of Ocean Science for Sustainable Development (2021–2030).",
      "sdo:location": "Brazil",
      "sdo:identifier": "589",
      "sdo:url": "https://oceandecade.org/actions/com-vida-caic-project/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Center for Child and Adolescent Care Ayrton Senna da Silva"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/UN7"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/57.1",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "BlueActionAA",
      "sdo:name": "BlueActionAA",
      "sdo:description": "BlueActionAA empowers coastal and inland communities across the Atlantic and Arctic regions to co‑design, implement and scale ocean and freshwater restoration solutions. The initiative supports community‑led actions that restore ecosystems and biodiversity, reduce pollution, and strengthen climate resilience, while advancing a fair and carbon‑neutral blue economy. Through targeted cascading grants, technical assistance and capacity development, BlueActionAA helps local actors move from ideas to implementation and from pilots to scalable solutions. The initiative creates clear pathways from science and local knowledge to decision‑making by supporting policy implementation and strengthening collaboration between communities, scientists, public authorities and other ocean stakeholders. BlueActionAA contributes directly to the goals of the UN Ocean Decade and the EU Mission Ocean by enabling inclusive, solutions‑oriented action that delivers measurable environmental and societal impact.",
      "sdo:location": "Ireland",
      "sdo:identifier": "57.1",
      "sdo:url": "https://oceandecade.org/actions/blueactionaa/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Marine Institute, Ireland"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Contribution",
          "sdo:description": "A Contribution is a one-off standalone initiative (such as an awareness-raising event, a scientific workshop, a training opportunity or a publication). It enables a Decade Programme or Project, or directly contributes to a Decade Challenge.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ]
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/832",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Sustainable Blue Economy Partnership",
      "sdo:name": "Sustainable Blue Economy Partnership",
      "sdo:description": "SBEP (Sustainable Blue Economy Partnership) is applying to become a Decade Implementing Partner (DIP) of the UN Ocean Decade to strengthen the science-policy-business interface and amplify collective action towards a sustainable ocean. As a major European and international R&I partnership bringing together 81 partners from 32 countries, SBEP already contributes extensively to the Ocean Decade through co-branded transnational calls, endorsed Decade Actions, thematic programmes, and active collaboration with Decade Coordination Structures and programmes such as Sustainable Ocean Planning. SBEP’s activities contribute across nearly all Ocean Decade Challenges, including sustainable blue economy development, ocean observation, digital twins, ocean literacy, coastal resilience, marine spatial planning, and source-to-sea research. Through its funding portfolio, community of practice, and policy engagement, SBEP supports transformative, science-based solutions aligned with SDG 14 and the Vision 2030 process. As a DIP, SBEP proposes to further scale the Ocean Decade’s impact by expanding co-branded calls, supporting endorsement of additional projects, building thematic and regional portfolios, strengthening outreach and capacity development, and fostering stronger engagement between projects, National Decade Committees, and global stakeholders. SBEP also aims to enhance cooperation with LDCs and SIDS, promote knowledge sharing, and contribute to major Decade events and communications.",
      "sdo:location": "Belgium",
      "sdo:identifier": "832",
      "sdo:url": "https://oceandecade.org/actions/sustainable-blue-economy-partnership/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Sustainable Blue Economy Partnership (SBEP)"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Contribution",
          "sdo:description": "A Contribution is a one-off standalone initiative (such as an awareness-raising event, a scientific workshop, a training opportunity or a publication). It enables a Decade Programme or Project, or directly contributes to a Decade Challenge.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ]
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/833",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "EuroMarine Association (European Marine Research Network)",
      "sdo:name": "EuroMarine Association (European Marine Research Network)",
      "sdo:description": "EuroMarine Association is a pan-European marine science network that brings together research-performing organisations across all European sea basins. As a proposed Decade Implementing Partner, it would serve primarily as a bottom-up, member-driven platform supporting cross-basin exchange, co-design, networking, training, and foresight rather than basin-specific implementation. Thematically, EuroMarine is strongly positioned at the interface of biodiversity and ecosystem restoration, ocean-climate interactions, ocean observation and data mobilisation, capacity development, and science–society engagement. Through its funding schemes, working groups, schools, and early-career programmes, it translates broad scientific and policy priorities into collaborative research agendas and communities of practice.",
      "sdo:location": "France",
      "sdo:identifier": "833",
      "sdo:url": "https://oceandecade.org/actions/euromarine-association-european-marine-research-network/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "EuroMarine Association (European Marine Research Network)"
      },
