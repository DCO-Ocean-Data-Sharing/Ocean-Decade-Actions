    {
      "@id": "https://purl.org/oceandecade/decadeactions/161",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Deltas associated with large rivers: Seeking solutions to the problem of sustainability",
      "sdo:name": "Deltas associated with large rivers: Seeking solutions to the problem of sustainability",
      "sdo:description": "River deltas are critical for human development. However, the delta is facing threats such as increased erosion, increased flood risk, and shrinking salt marshes and mangroves. This has become a global problem and requires international cooperation to solve it. We propose to study the present status and threats of 25 representative deltas, the methodology for new delta blueprints, the blueprints dealing with critical delta characteristics, and the sustainability of the delta system and its capacity to support regional development for deltas of different physical processes and ecological and economic importance. The objective is to support sustainable development in delta regions.",
      "sdo:location": "China",
      "sdo:identifier": "161",
      "sdo:url": "https://oceandecade.org/actions/Deltas-associated-with-large-rivers-Seeking-solutions-to-the-problem-of-sustainability/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "the State Key Laboratory of Estuarine and Coastal Research (SKLEC), East China Normal University."
      },
