      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/23.5",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "National Seabed Enhancement Programme",
      "sdo:name": "National Seabed Enhancement Programme",
      "sdo:description": "Discover the National Programme for the Development of the Senegalese Seabed! We are committed to protecting and enhancing our country's marine resources. Using advanced mapping techniques, we accurately map the seabed to better understand the characteristics of our marine environment and improve the management of our resources. We also work on the creation of marine protected areas, sustainable fisheries and the installation of marine infrastructure to stimulate economic growth and improve the quality of life of coastal communities. Join us in our mission to protect and enhance Senegal's seabed for future generations!",
      "sdo:location": "Senegal",
      "sdo:identifier": "23.5",
      "sdo:url": "https://oceandecade.org/actions/citizens-of-surf-cos/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "The Directorate of Management and of the Exploitation Seabed Senegal"
      },
