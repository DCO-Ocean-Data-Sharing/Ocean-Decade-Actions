    {
      "@id": "https://purl.org/oceandecade/decadeactions/57.7",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Marine Spatial Planning Addressing Climate Effects",
      "sdo:name": "Marine Spatial Planning Addressing Climate Effects",
      "sdo:description": "MSPACE is a four-year transdisciplinary project based in the UK, aimed at supporting the implementation of climate-smart Marine Spatial Planning (MSP). Co-designed and co-delivered with UK policymakers and marine industries, the project focuses on conservation, fisheries, and aquaculture. It aims to develop economically viable, socially acceptable strategies, built on the identification of climate change refugia for specific sectors, and economic and social value of acting upon them through planning to help meet the specific needs of UK nations and regions. The final product is a free AI assisted web tool to support this type of decision making. MSPACE offers practical guidance for sustainable marine resource management, ensuring adaptability to future climate scenarios and stakeholder values. Partnerships across Europe and the UK overseas territories are expanding the use of the MSPACE tool kit across the world.",
      "sdo:location": "United Kingdom of Great Britain and Northern Ireland (UK)",
      "sdo:identifier": "57.7",
      "sdo:url": "https://oceandecade.org/actions/marine-spatial-planning-addressing-climate-effects/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Plymouth Marine Laboratory"
      },
      "sdo:keywords": [
