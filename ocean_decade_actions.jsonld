      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "MPAs as sentinel sites for ocean conservation, science and literacy",
      "sdo:name": "MPAs as sentinel sites for ocean conservation, science and literacy",
      "sdo:description": "Programs seeks to: 1) Understand climate impacts affecting the oceans  2) Promote research on MPA uses and socioeconomic benefits to coastal communities;    3) Develop initiatives to promote ocean literacy  4) Support national and international initiatives to establish networks of MPAs.",
