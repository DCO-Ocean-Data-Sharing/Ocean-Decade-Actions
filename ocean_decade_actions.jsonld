    {
      "@id": "https://purl.org/oceandecade/decadeactions/5.6",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Caspian Sea Carbon Dioxide Removal Project (CaspianCDR)",
      "sdo:name": "Caspian Sea Carbon Dioxide Removal Project (CaspianCDR)",
      "sdo:description": "CaspianCDR is a research project to develop technology to remove carbon dioxide through the natural process of photosynthesis in the Caspian Sea. Our research was inspired by Briliant Planet's innovative process to grow vast quantities of microalgae in open ponds on coastal desert land. This is achieved without the use of fresh water, by utilizing a natural process that contributes to healthier oceans and air.",
      "sdo:location": "Kazakhstan",
      "sdo:identifier": "5.6",
      "sdo:url": "https://oceandecade.org/actions/caspian-sea-carbon-dioxide-removal-project-caspiancdr/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Caspian Environmental Consortium Ltd."
      },
