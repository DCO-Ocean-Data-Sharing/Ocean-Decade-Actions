    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/28.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "South African Innovation Lab for Ocean-Climate Resilience (SAILOR)",
      "sdo:name": "South African Innovation Lab for Ocean-Climate Resilience (SAILOR)",
      "sdo:description": "Kinjani’s mCDR and ecosystem restoration programme supports founders in leveraging the ocean’s vast capacity for carbon sequestration and ecosystem repair. It provides resources, expertise and funding pathways to build transformative ventures with scientific proof points.  The  Challenge & Opportunity Rising GHG drive ocean heating, acidification, and biodiversity loss. The ocean has absorbed 90% of excess heat, with acidity up 30% since the Industrial Revolution. We must harness its power to restore the climate and develop sustainable industries.  Focus Areas: Carbon Sequestration: mCDR Decarbonised Shipping: Low-emission maritime solutions Sustainable Aquaculture: Regenerative seafood & biomass Ocean-Based Feedstocks: Marine-sourced industrial materials Programme Structure  Inspiration & Opportunity (Month 1) – Expert-led deep dives Validation & Development (Month 2) – Feasibility & business model iteration Go-To-Market & Scaling (Months 3-4) – Pilots, customers & fundraising",
      "sdo:location": "South Africa",
      "sdo:identifier": "28.8",
      "sdo:url": "https://oceandecade.org/actions/mcdr-and-ecosystem-restoration-venture-builder/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
