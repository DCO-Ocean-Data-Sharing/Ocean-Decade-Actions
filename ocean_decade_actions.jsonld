    {
      "@id": "https://purl.org/oceandecade/decadeactions/75.7",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Soneva Conservation and Sustainability Maldives",
      "sdo:name": "Soneva Conservation and Sustainability Maldives",
      "sdo:description": "Soneva Conservation & Sustainability Maldives (CSM) is a Maldivian-registered NGO established in 2023 to advance coral reef regeneration, marine research, and community stewardship. Serving as a national hub for coral restoration, Soneva CSM operates projects across Kunfunadhoo, Medhufaru, Muravandhoo, Maaranfushi, and Maalhos islands. The organisation combines cutting-edge research and development,including coral spawning, microfragmentation, photogrammetry, and probiotic trials, with community-based conservation, capacity-building for Maldivian youth, and sustainable livelihood initiatives. Through partnerships with UNDP, the Global Fund for Coral Reefs, the Waitt Foundation, and leading universities such as Bremen, Southern Cross, Exeter and KAUST, Soneva CSM integrates science, finance, and education to restore reef ecosystems and strengthen coastal resilience. Its mission is to position the Maldives as a global model for regenerative marine conservation through collaboration, innovation, and local empowerment",
      "sdo:location": "Maldives",
      "sdo:identifier": "75.7",
      "sdo:url": "https://oceandecade.org/actions/soneva-foundation-coral-restoration/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Soneva Conservation & Sustainability Maldives (CSM)"
      },
      "sdo:keywords": [
