    {
      "@id": "https://purl.org/oceandecade/decadeactions/820",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "European Global Ocean Observing System (EuroGOOS)",
      "sdo:name": "European Global Ocean Observing System (EuroGOOS)",
      "sdo:description": "EuroGOOS is the European component of the Global Ocean Observing System of the IOC/UNESCO. EuroGOOS identifies priorities, enhances cooperation and promotes the benefits of operational oceanography to ensure sustained observations are made in Europe’s seas underpinning a suite of fit-for-purpose products and services for marine and maritime end-users.",
