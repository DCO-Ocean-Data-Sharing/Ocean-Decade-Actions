    {
      "@id": "https://purl.org/oceandecade/decadeactions/819",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "National Research Council of Canada – Ocean Program",
      "sdo:name": "National Research Council of Canada – Ocean Program",
      "sdo:description": "The National Research Council of Canada (NRC) is the premier national agency of the Government of Canada, committed to advancing science and technology research and development. The NRC’s Ocean program is one of five cluster support programs with the primary objective of promoting the growth of Canada’s blue economy. The Ocean program is presently in its third of a seven-year mandate. It has set forth two key objectives: firstly, to align its objectives and outcomes with those of the Ocean Supercluster, and secondly, to increase the economic value of solutions that restore the world’s oceans to a sustainable state of health. The overarching vision of the Ocean Program is to create “a thriving ocean economy within a thriving ocean environment (aka, a thriving blue economy) – Ocean health, Ocean wealth”. Its mission is dedicated to generating knowledge and developing technologies, through collaborations, partnerships, and self- directed research, to improve ocean health, and use the ocean’s immense potential to benefit Canada’s economy and address the world’s climate problem in a sustainable and inclusive manner.",
      "sdo:location": "Canada",
      "sdo:identifier": "819",
      "sdo:url": "https://oceandecade.org/actions/national-research-council-of-canada-ocean-program/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "National Research Council of Canada"
      },
