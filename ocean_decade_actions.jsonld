    {
      "@id": "https://purl.org/oceandecade/decadeactions/2.7",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Ocean Community Challenge: Educating, Innovating",
      "sdo:name": "Ocean Community Challenge: Educating, Innovating",
      "sdo:description": "The Ocean Community Challenge (OCC) Initiative empowers communities and entrepreneurs to develop sustainable ocean-based solutions. Through a comprehensive ocean literacy platform, pre-accelerator programs, and community engagement, OCC fosters innovation, education, and awareness, driving positive change in ocean conservation and sustainable development. Our initiative targets diverse global audiences, including underrepresented regions, ensuring inclusive participation and capacity building in ocean science and sustainability.",
      "sdo:location": "Portugal",
      "sdo:identifier": "2.7",
      "sdo:url": "https://oceandecade.org/actions/ocean-community-challenge-educating-innovating/",
