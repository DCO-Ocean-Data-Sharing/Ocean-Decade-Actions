    {
      "@id": "https://purl.org/oceandecade/decadeactions/16.5",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Kelp Forest Challenge",
      "sdo:name": "Kelp Forest Challenge",
      "sdo:description": "The Kelp Forest Challenge is a collaborative, global mission to protect and restore 4 million hectares of kelp forests by 2040. These ecosystems are truly the forests of the sea and are the largest biological marine habitat on planet and create hundreds of billions of dollars every year. The Kelp Forest Challenge is a grassroots initiative launched by the Kelp Forest Alliance in collaboration with hundreds of people and organisations across countries, languages, and professions. Through The Challenge, almost any government agency, business, NGO, community group, artist, or individual can join the movement and help the kelp. In addition to protecting or restoring kelp forests directly, organizations can make pledges to enable or assist conservation activities or increase awareness and understanding of kelp forests. Joining the Challenge demonstrates a commitment to saving our kelp and creating a healthier, more equitable marine environment, and provides traceable impacts for our oceans.",
      "sdo:location": "Australia",
      "sdo:identifier": "16.5",
      "sdo:url": "https://oceandecade.org/actions/kelp-forest-challenge/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Kelp Forest Alliance"
      },
