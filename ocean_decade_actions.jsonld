    {
      "@id": "https://purl.org/oceandecade/decadeactions/27.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Impacts of Climate change on MCH in Colombia",
      "sdo:name": "Impacts of Climate change on MCH in Colombia",
      "sdo:description": "Colombia's Maritime Cultural Heritage is at risk. Coastal, intertidal, and underwater cultural resources face severe threats to their conservation from both natural and human factors. Future generations may lose the chance to value and benefit from this legacy, which shapes identity and cultural continuity. Since 2021, the NGO Fundación Colombia Anfibia has worked to safeguard Maritime Heritage by developing research strategies and encouraging broad societal participation. A key challenge has been engaging vulnerable communities historically disconnected from heritage initiatives. This Decade Action will build on five years of ongoing research to expand initiatives that promote co-production of knowledge with local perspectives while also strengthening institutional capacities of relevant government entities. These actions will continue through 2030, ensuring that Maritime Cultural Heritage is preserved as a shared resource for the future.",
      "sdo:location": "Colombia",
      "sdo:identifier": "27.9",
      "sdo:url": "https://oceandecade.org/actions/impacts-of-climate-change-on-mch-in-colombia/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "ONG Fundación Colombia Anfibia"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/69"
      }
