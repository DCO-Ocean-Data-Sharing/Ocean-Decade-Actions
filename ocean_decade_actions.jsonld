    {
      "@id": "https://purl.org/oceandecade/decadeactions/48.2",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Beaufort Ecosystem Biodiversity",
      "sdo:name": "Beaufort Ecosystem Biodiversity",
      "sdo:description": "The BEB Decade Action is to integrate multi-year coastal and offshore research and monitoring programs to provide a comprehensive assessment of Beaufort Sea biodiversity across a wide range of habitats, including data-poor areas adjacent to the Central Arctic Ocean (CAO). Biodiversity will be assessed with an ecosystem-based approach providing the environmental context in which biodiversity change, and associated mechanisms of change, can be identified. This action will contribute to co-developing and enhancing monitoring of the Beaufort Sea to protect and manage the ecosystem biodiversity.",
      "sdo:location": "Canada",
      "sdo:identifier": "48.2",
      "sdo:url": "https://oceandecade.org/actions/Beaufort-Ecosystem-Biodiversity-/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Fisheries and Oceans Canada"
      },
