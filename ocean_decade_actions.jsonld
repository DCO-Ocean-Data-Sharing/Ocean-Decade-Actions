      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/52.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "BlueDOT - Divers for Ocean Temperature",
      "sdo:name": "BlueDOT - Divers for Ocean Temperature",
      "sdo:description": "In 2023, the Copernicus Climate Service reported alarming sea surface temperature records in the Mediterranean Sea, which have continued, highlighting persistent ocean heat excess. Ocean heatwaves impact ecosystems, fisheries, and coral reefs, and understanding them is crucial for coastal protection and climate change mitigation. Subsurface heatwaves, especially within the first 40 meters of the water column, have been observed by divers for years but remain undetected by current monitoring methods. The BlueDOT project aims to create an open-access database centralizing dive computer temperature data from this depth, complementing existing systems and improving our understanding of ocean warming. It will empower divers to act as citizen scientists, using their dive computers as scientific tools.",
      "sdo:location": "Germany",
      "sdo:identifier": "52.8",
      "sdo:url": "https://oceandecade.org/actions/bluedot-divers-for-ocean-temperature/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "MARUM - Centre for Marine Environmental Sciences University of Bremen"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/144"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/53.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Monitoring CECs impacts in European Seas",
      "sdo:name": "Monitoring CECs impacts in European Seas",
      "sdo:description": "Contaminants of emerging concern (CECs) are chemicals whose presence in the environment, and potential effects on human health and biodiversity, have only recently begun to be investigated. CECs include a wide range of chemicals used in different applications, e.g. pharmaceuticals, personal-care products, biocides, etc. Within CONTRAST, we aim to develop a monitoring framework based on an Integrated Assessment Framework (IAF), combining chemical measurements together with biological effects endpoints to detect the presence and degree of effect of CECs in the marine environment, using areas in European seas as case studies. The knowledge gained will form the basis for guidance documents and policy briefs on the best practices for performing an IAF on CECs in the marine environment. Furthermore, the interactions of climate change drivers on CECs will be evaluated including effects on CECs distribution, circulation, fate, bioavailability, and toxicity to marine life.",
      "sdo:location": "Norway",
      "sdo:identifier": "53.8",
      "sdo:url": "https://oceandecade.org/actions/monitoring-cecs-impacts-in-european-seas/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Norwegian Institute for Water Research"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
