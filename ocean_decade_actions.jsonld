    {
      "@id": "https://purl.org/oceandecade/decadeactions/42.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Deep Ocean Microbiomes and Elemental Cycle",
      "sdo:name": "Deep Ocean Microbiomes and Elemental Cycle",
      "sdo:description": "As a core component of the DOME initiative, this project will focus on microbial diversity, activities and mechanisms of element cycling at key deep subsurface biosphere with sediment cores obtained from the deep seabed by the D/V Mengxiang, to elucidate the profound linkage between microbial diversity and ecological processes in the subseafloor biosphere. Key outcomes: 1)Advancing scientific understanding of the deep \"microbe–rock–element\" co-evolution process, with a focus on material and energy cycling between the ocean and the subseafloor biosphere mediated by the subseafloor microbes. 2)Developing in situ long-term seafloor borehole monitoring systems—the CORK and shipboard laboratories for real-time microbial analysis and monitoring, while establishing standardized protocols for core collection, handling, and seafloor observation. 3)Promoting capacity development, sharing of seafloor drilling databases to foster sustained international collaboration in deep subseafloor research.",
      "sdo:location": "China",
      "sdo:identifier": "42.9",
      "sdo:url": "https://oceandecade.org/actions/deep-ocean-microbiomes-and-elemental-cycle/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Guangzhou Marine Geological Survey"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
