    {
      "@id": "https://purl.org/oceandecade/decadeactions/9.6",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "AquaRio in the ocean decade",
      "sdo:name": "AquaRio in the ocean decade",
      "sdo:description": "Aquário Marinho do Rio de Janeiro (AquaRio) seeks strategies for awareness and didactic actions that contribute to marine conservation, aiming to foster critical and reflective citizens capable of positively impacting their local actions for global effect. As a means of popularizing the Sustainable Development Goals (SDGs) and oceanic culture, the institution plans to implement actions involving guided tours with visitors throughout the exhibition circuit, Educational Sector exhibitions to collect information for research and convey the message to the public through pedagogical activities, informative signs, and other forms of digital signage, external socio-environmental educational actions, and ecosystem restoration. Additionally, scientific research in partnership with various institutions and universities will focus on the conservation of rays and sharks, coral reefs, and other endeavors aimed at ocean conservation.",
      "sdo:location": "Brazil",
      "sdo:identifier": "9.6",
      "sdo:url": "https://oceandecade.org/actions/aquario-in-the-ocean-decade/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Instituto Museu Aquário Marinho do Rio de Janeiro"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
