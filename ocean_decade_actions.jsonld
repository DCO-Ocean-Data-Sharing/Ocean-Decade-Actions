          }
        }
      ]
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/13.5",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "NileClean: Combat Plastic Pollution in the Nile",
      "sdo:name": "NileClean: Combat Plastic Pollution in the Nile",
      "sdo:description": "NileClean is a multifaceted program that aims to address the issue of plastic pollution in the Nile River, one of the world's most important water bodies that flow into the Mediterranean Sea. The program focuses on implementing a range of strategies to reduce plastic waste, raise awareness, and promote sustainable practices among local communities, industries, and policymakers. The NileClean aims to not only protect the Nile River but also reduce the amount of plastic waste that ends up in the Eastern Mediterranean Sea. Furthermore, the NileClean can collaborate with organizations and initiatives that focus on reducing plastic pollution in the Eastern Mediterranean basin, and promote sustainable practices that can benefit both the Nile River and the Mediterranean Sea. Through this program, we aim to raise awareness about the interconnectedness of different water bodies and inspire global action to address plastic pollution.",
      "sdo:location": "Egypt",
      "sdo:identifier": "13.5",
      "sdo:url": "https://oceandecade.org/actions/nileclean-combat-plastic-pollution-in-the-nile/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "National Institute of Oceanography and Fisheries"
      },
