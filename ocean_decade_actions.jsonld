    {
      "@id": "https://purl.org/oceandecade/decadeactions/45.5",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Vaka Oceanstory Lab",
      "sdo:name": "Vaka Oceanstory Lab",
      "sdo:description": "The \"Vaka Oceanstory Lab » initiative by the Okeanos Foundation leverages traditional Polynesian sailing canoes, Vakas, as a platform for inspirational knowledge, exploration and social change. Crewed by indigenous knowledge holders and captained by indigenous celestial navigators, each Vaka sleeps 12 and transports up to 3 tons. Okeanos’ Vakas have aided in disaster relief, connectivity, and research in the Pacific Ocean. As climate change intensifies, there is an urgent need to combine indigenous knowledge with the latest science to mitigate and adapt to changes. Over 2024-2026, two Vakas will serve as platforms for film-makers, indigenous knowledge holders, and story tellers, and will collect and share insights via partnerships with local communities, universities, museums and media platforms. By uniting tradition and science, VOL will aid in marine ecosystem management and will promote ocean literacy leading to a holistic and sustainable future for marine conservation.",
      "sdo:location": "Germany",
      "sdo:identifier": "45.5",
      "sdo:url": "https://oceandecade.org/actions/vaka-oceanstory-lab/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Okeanos Foundation for the sea"
      },
