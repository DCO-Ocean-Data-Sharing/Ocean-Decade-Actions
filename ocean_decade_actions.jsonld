    {
      "@id": "https://purl.org/oceandecade/decadeactions/586",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "The VLE Blueprint Accelerator",
      "sdo:name": "The VLE Blueprint Accelerator",
      "sdo:description": "The VLE Blueprint Accelerator is a strategic in-kind contribution to the Ocean Decade. We address a critical bottleneck: Many brilliant innovators lack the strategic capacity to turn their vision into fundable, high-impact Decade Actions. Through our prestigious annual 'VLE Founder's Award', we identify one visionary 'hidden champion' and forge them through our proven 'VLE Impact Blueprint' process – a 4-week strategic sprint that builds an irresistible, investment-ready project architecture. We are not a project. We are a pipeline, delivering one perfectly crafted, ready-to-launch Decade Action, year after year.",
      "sdo:location": "Portugal",
      "sdo:identifier": "586",
      "sdo:url": "https://oceandecade.org/actions/the-vle-blueprint-accelerator/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Vita Loom Labs"
      },
