    {
      "@id": "https://purl.org/oceandecade/decadeactions/UN47",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Decade Coordination Office for Tropical Americas and Caribbean",
      "sdo:name": "Decade Coordination Office for Tropical Americas and Caribbean",
      "sdo:description": "The Tropical Americas and Caribbean (TAC) Region encompasses the Western Tropical Atlantic, Caribbean Sea, and Eastern Tropical Pacific, and includes some of the most biologically rich and geopolitically diverse marine areas in the world. It is home to many Small Island Developing States (SIDS), coastal nations, and overseas territories whose economies and cultures are deeply tied to the ocean. Yet, challenges persist across the region, including fragmented marine spatial planning, weak governance in areas beyond national jurisdiction (ABNJ), limited regional ocean observation infrastructure, and persistent gaps in capacity, especially for island and coastal communities.Fisheries, aquaculture, and marine-based tourism are key pillars of the region’s economy and food security, but are under increasing threat from climate change, marine pollution, and overexploitation. Despite these pressures, there remain significant gaps in ecosystem-based management, the application of ocean science and services, and the capacity to enforce regulations that support ocean conservation and sustainable use. The TAC Decade Coordination Office plays a central role in advancing coordinated action across the region. It works in partnership with national governments, SIDS, regional organizations, academia, NGOs and the private sector to support the co-design, implementation, and monitoring of Ocean Decade Actions.",
      "sdo:location": "Colombia",
      "sdo:identifier": "UN47",
      "sdo:url": "https://oceandecade.org/actions/decade-coordination-office-for-the-tropical-americas-and-caribbean/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "IOC Sub-Commission for the Caribbean and Adjacent Regions (IOCARIBE)"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Contribution",
          "sdo:description": "A Contribution is a one-off standalone initiative (such as an awareness-raising event, a scientific workshop, a training opportunity or a publication). It enables a Decade Programme or Project, or directly contributes to a Decade Challenge.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ]
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/UN48",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Decade Coordination Office for Africa",
      "sdo:name": "Decade Coordination Office for Africa",
      "sdo:description": "The Africa Region encompasses the continent’s extensive coastal and marine areas, and is characterized by remarkable biological diversity and complex geopolitical landscapes. It is home to numerous Small Island Developing States (SIDS), coastal nations, and mainland countries whose economies, livelihoods, and cultures are intimately linked to the ocean. However, the region faces significant challenges, including fragmented marine spatial planning, limited governance capacity in areas beyond national jurisdiction (ABNJ), uneven ocean observation infrastructure, and persistent gaps in scientific, technical, and policy capacities, particularly among island and coastal communities. Fisheries, aquaculture, shipping, and marine-based tourism are critical to the region’s economy and food security, yet they are increasingly threatened by climate change, marine pollution, and overexploitation. Despite these pressures, there are substantial gaps in ecosystem-based management, the application of ocean science and services, and the capacity to implement and enforce measures that promote sustainable ocean use and conservation. The DCO Africa plays a central role in facilitating coordinated action across the region. It partners with National Decade Committees and the Taskforce including national governments, SIDS, regional organizations, research institutions, NGOs, and the private sector to support the co-design, implementation, and monitoring of Ocean Decade Actions, fostering a collaborative approach to sustainable ocean management and the advancement of ocean science in Africa.",
      "sdo:location": "Kenya",
      "sdo:identifier": "UN48",
      "sdo:url": "https://oceandecade.org/actions/decade-coordination-office-for-africa/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "IOC Sub Commission for Africa and the Adjacent Island States (IOC AFRICA)"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Contribution",
          "sdo:description": "A Contribution is a one-off standalone initiative (such as an awareness-raising event, a scientific workshop, a training opportunity or a publication). It enables a Decade Programme or Project, or directly contributes to a Decade Challenge.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ]
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/578",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "International Platform for Ocean Sustainability (IPOS)",
      "sdo:name": "International Platform for Ocean Sustainability (IPOS)",
      "sdo:description": "The International Platform for Ocean Sustainability (IPOS) is a global initiative created by the Ocean Sustainability Foundation (OSF) to connect ocean knowledge with decision-making and accelerate action toward ocean sustainability. Acting as a bridge between science, policy and society, IPOS provides contextualized, accessible and inclusive knowledge to support governments and stakeholders in implementing their international ocean commitments. Its decentralized structure combines a global Secretariat, scientific committees and regional nodes that engage experts, local communities, the private sector and international organizations, promoting cross-sectoral cooperation and the equitable use of knowledge to deliver practical solutions for ocean conservation, a sustainable blue economy and climate resilience.",
      "sdo:location": "France",
      "sdo:identifier": "578",
      "sdo:url": "https://oceandecade.org/actions/international-platform-for-ocean-sustainability-ipos/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Ocean\nSustainability Foundation (OSF)"
      },
      "sdo:keywords": [
