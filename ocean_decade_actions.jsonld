    {
      "@id": "https://purl.org/oceandecade/decadeactions/555",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "MS in Science and Design for MSP",
      "sdo:name": "MS in Science and Design for MSP",
      "sdo:description": "The two-year Ms in Science and Design for Maritime Spatial Planning, offered by the Iuav University of Venice, integrates scientific and design-based disciplines in an innovative and multidisciplinary manner, covering oceanography, marine biological sciences, land and environmental planning, coastal planning, and landscape architecture. The programme combines theoretical knowledge with workshops and practice-based learning, providing students with a comprehensive set of skills and techniques for maritime spatial planning. The course trains professionals with the skills needed to work as consultants for private sectors engaged in maritime and coastal activities as well as for public sector entities. The programme is the first Master of Science entirely dedicated to these topics. Teaching activities are developed in collaboration with the National Research Council-Institute of Marine Sciences.",
      "sdo:location": "Italy",
      "sdo:identifier": "555",
      "sdo:url": "https://oceandecade.org/actions/ms-in-science-and-design-for-msp/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Università IUAV di Venezia"
      },
      "sdo:keywords": [
