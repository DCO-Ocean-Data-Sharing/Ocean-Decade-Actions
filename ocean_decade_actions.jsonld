    {
      "@id": "https://purl.org/oceandecade/decadeactions/557",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "EU Ocean research and innovation",
      "sdo:name": "EU Ocean research and innovation",
      "sdo:description": "In line with the joint roadmap for cooperation on the Ocean between IOC-UNESCO and DG Research and Innovation of the European Commission, adopted on 12 April 2024 (https://oceandecade.org/news/european-commission-and-ioc-unesco-join-forces-on-the-un ocean-decade/), key EU contributions to the Ocean Decade include (i) EU Framework 4 programme for research and innovation, Horizon Europe, (ii) the EU Mission Ocean and Waters including its European Digital Twin of the Ocean, (iii) the European Sustainable Blue Economy partnership (SBEP) and (iv) the All-Atlantic Ocean Research and Innovation Alliance (AAORIA).",
      "sdo:location": "Belgium",
      "sdo:identifier": "557",
      "sdo:url": "https://oceandecade.org/actions/eu-ocean-research-and-innovation/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "DG Research and Innovation, European Commission"
      },
