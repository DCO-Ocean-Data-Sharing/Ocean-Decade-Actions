    {
      "@id": "https://purl.org/oceandecade/decadeactions/531",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "The Sea as a Good Cause in support to the OD",
      "sdo:name": "The Sea as a Good Cause in support to the OD",
      "sdo:description": "Flanders Marine Institute (VLIZ), as a technical partner for ocean research and innovation to the Flanders government (EWI) wants to contribute to the Ocean Decade through its Philanthropy entity (The Sea as a Good Cause). It actively seeks funding from a broad range of donors that have a local embedding and a track record in the transition towards (social/environmental) sustainability and/or commitment with the Ocean Decade mission and priorities. In doing so, ‘The Sea as a Good Cause in support to the Ocean Decade’ (VLIZ philanthropy) seeks  –as a grant-ma king facility  - engagement in a long-term perspective for the Ocean Decade and beyond.",
      "sdo:location": "Belgium",
      "sdo:identifier": "531",
      "sdo:url": "https://oceandecade.org/actions/the-sea-as-a-good-cause-in-support-to-the-ocean-decade/",
