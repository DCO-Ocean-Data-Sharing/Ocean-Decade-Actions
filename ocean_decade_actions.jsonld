      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/140.2",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "MACHC-IOCARIBE Seabed 2030 Project",
      "sdo:name": "MACHC-IOCARIBE Seabed 2030 Project",
      "sdo:description": "The priority Project outcome is to create an accurate, observation-based bathymetric map of the Tropical Americas and Caribbean Region through multi-sector partnerships and collaboration.  This map is essential for the sustainable use of critical ocean resources and to inform and improve forecast capabilities, disaster risk reduction and response, environmental management and scientific investigation activities.  A diverse region that has rich biodiversity and marine resources, many economies are dependent on coastal and marine tourism.  The region is also extremely vulnerable to climate change and natural hazards.  Extreme weather events are common in the region with nine Category 3 hurricanes and above occurring in 2019-2020.   Currently 23% of the region is mapped according to the GEBCO 2021 Grid, an increase of 3% since 2020 when the IOCARIBE and the MACHC initiated this joint Project.  This progress is highly encouraging given the pandemic circumstances.",
      "sdo:location": "Jamaica",
      "sdo:identifier": "140.2",
      "sdo:url": "https://oceandecade.org/actions/MACHC-IOCARIBE-Seabed-2030-Project/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "National Land Agency Hydrographic Unit"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/107"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/141.2",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "IGIF-Hydro",
      "sdo:name": "IGIF-Hydro",
      "sdo:description": "The goal of the UN WG-MGI produced Operational Framework for Integrated Marine Geospatial Information (IGIF-H) is the efficient use of geospatial information by all countries to facilitate decision-making in support of sustainable oceans and seas, coastal zones, deltas and tributaries, and inland water bodies and waterways.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "141.2",
      "sdo:url": "https://oceandecade.org/actions/IGIF-Hydro-/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "United Nations Working Group on Marine Geospatial Information (UNWG-MGI), UN Committee of Experts on Global Geospatial Information Management  (UN-GGIM)"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Contribution",
          "sdo:description": "A Contribution is a one-off standalone initiative (such as an awareness-raising event, a scientific workshop, a training opportunity or a publication). It enables a Decade Programme or Project, or directly contributes to a Decade Challenge.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ]
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/142.2",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "NOAA Harmful Algal Bloom Forecasting",
      "sdo:name": "NOAA Harmful Algal Bloom Forecasting",
      "sdo:description": "NOAA’s Harmful Algal Bloom (HAB) forecasts alert coastal managers to blooms before they cause serious damage. Short-term (up to twice weekly) and longer-term seasonal forecasts identify potentially harmful levels of developing algal biomass, including projected bloom location, size, direction, and severity in a particular region. NOAA continues to issue HAB forecasts by region, which are based on understanding the causes of HABs and how they respond to changing weather, physical ocean conditions, and in-situ environmental factors. NOAA additionally funds research in support of operationalizing several pilot regional HAB forecasts for continued prevention and mitigation.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "142.2",
      "sdo:url": "https://oceandecade.org/actions/NOAA-Harmful-Algal-Bloom-Forecasting/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "NOAA National Centers for Coastal Ocean Science"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ]
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/143.2",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Open Access to GTS Project (Open-GTS Project)",
      "sdo:name": "Open Access to GTS Project (Open-GTS Project)",
      "sdo:description": "The Open Access to GTS (Open-GTS) project aims to ease the exchange of marine data and increase the amount of data available for real-time forecasts.  The ability of Open-GTS to accept multiple data format types is significant and promising.  The application of the Open-GTS workflow will increase the exchange of marine data while retaining data quality and integrity, and its framework will increase transparency and encourage participation from other marine interests, including the commercial shipping industry.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "143.2",
      "sdo:url": "https://oceandecade.org/actions/open-access-to-gts-project-open-gts-project/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "NOAA Pacific Marine Environmental Lab"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ]
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/144.2",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "US Tsunami Contributions to IOC Tsunami Pt 1",
      "sdo:name": "US Tsunami Contributions to IOC Tsunami Pt 1",
      "sdo:description": "NOAA commits to supporting the UN Decade of Ocean Science goal of reducing the time required to detect, measure, and characterize tsunamis. NOAA will: (1) Assist in drafting the UN Decade IOC Tsunami  Programme’s 10-year Research, Development and Implementation Plan; (2) Share advanced tsunami source detection and measurement capabilities, including seismic and GNSS applications; (3) Promote collaboration with industry and research institutions to access critical, real-time observational data (e.g., SMART);  and (4) Continue to develop and deploy advanced tsunameters (e.g., DART system) and (5) support capacity building of Small Island and Least Developed States to use new data streams in their decision-making and for data interpretation and inversion to correctly characterize sources",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "144.2",
      "sdo:url": "https://oceandecade.org/actions/us-tsunami-contributions-to-ioc-tsunami-pt-1/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
