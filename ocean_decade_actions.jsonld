      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/72.5",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Elite Centre of Aquatic Nature-based Solutions",
      "sdo:name": "Elite Centre of Aquatic Nature-based Solutions",
      "sdo:description": "The Elite Centre of Aquatic Nature-based Solutions for Climate Change Adaptation and Mitigation (aquaNbS) aims to scale up and integrate approaches of Aquatic Nature-based Solutions to expand the provision of multiple ecosystem services, including carbon storage, climate regulation, water filtration, coastal protection, and food-web support. We apply cross-disciplinary approaches that span the full land-sea continuum and incorporate a comprehensive range of technological, institutional, and socio-economic settings. Aqua-NbS will investigate aquatic habitats and their valuable ecosystem services to craft inclusive, detailed guidelines on cost-effective opportunities and address the challenges in upscaling aquatic NbS. The project is strongly based on knowledge brokerage and co-creation through the involvement of key stakeholders at national and international levels, including local communities and civil society.",
      "sdo:location": "Denmark",
      "sdo:identifier": "72.5",
      "sdo:url": "https://oceandecade.org/actions/elite-centre-of-aquatic-nature-based-solutions/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "University of Southern Denmark"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
