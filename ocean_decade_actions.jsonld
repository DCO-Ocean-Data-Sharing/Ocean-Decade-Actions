    {
      "@id": "https://purl.org/oceandecade/decadeactions/3",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "The Global GO-SHIP Survey in support of the Ocean Decade 2021-2030",
      "sdo:name": "The Global GO-SHIP Survey in support of the Ocean Decade 2021-2030",
      "sdo:description": "GO-SHIP evolve' will focus on emerging opportunities for the fourth decadal GO-SHIP survey in three areas   •\tNew science area   o\tAddition of biological and ecosystem measurements enabling GO-SHIP to determine changes in key indicators of ocean health.   •\tAccelerating use of knowledge  o\tExpanding provision of real-time data.    o\tFit-for purpose provision of calibration data to evolving partner networks including Argo.   o\tNew stakeholder-driven data products;    •\tMultinational capability: enabling contributions from more new nations    o\tDeveloping access and training opportunities;   o\tSupporting and facilitating multinational voyages and shared facilities.  o\tNew funding models of funding for program-wide support and capability.",
      "sdo:location": "Norway",
      "sdo:identifier": "3",
      "sdo:url": "https://oceandecade.org/actions/go-ship-evolve/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "GO-SHIP program office"
      },
