    {
      "@id": "https://purl.org/oceandecade/decadeactions/809",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Partnership for Observation of the Global Ocean (POGO)",
      "sdo:name": "Partnership for Observation of the Global Ocean (POGO)",
      "sdo:description": "The Partnership for Observation of the Global Ocean (POGO) was founded in 1999 by directors of oceanographic institutions around the world as a forum to promote and advance the observation of the global ocean. POGO is a UK-registered charity with member institutions from around the world, and works closely with other international and regional programmes and organisations.",
      "sdo:location": "United Kingdom of Great Britain and Northern Ireland (UK)",
      "sdo:identifier": "809",
      "sdo:url": "https://oceandecade.org/actions/partnership-for-observation-of-the-global-ocean-pogo/",
