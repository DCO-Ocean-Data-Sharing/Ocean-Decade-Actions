    {
      "@id": "https://purl.org/oceandecade/decadeactions/6.7",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Boosting Women’s access to Maritime Training",
      "sdo:name": "Boosting Women’s access to Maritime Training",
      "sdo:description": "The maritime sector, crucial to global trade, suffers from a significant gender imbalance, with women making up only 2% of the world’s 1.2 million seafarers. In Togo, just 3 out of about 50 ship captains are women. Despite the sector’s importance, traditional barriers and biases restrict women’s participation, particularly in navigation roles like ship captains and deck officers. To address this, it's essential to support women’s access to maritime training and create inclusive environments in education and employment. The Ocean Decade Action titled \"Improvement of Women's Access to Maritime Navigation Training in Togo\" aims to promote gender equality and enhance opportunities for women in the maritime sector.",
      "sdo:location": "Togo",
      "sdo:identifier": "6.7",
      "sdo:url": "https://oceandecade.org/actions/boosting-womens-access-to-maritime-training/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Ministry of Maritime Economy and Coastal Protection"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ]
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/7.7",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Tracking ghost gear and Recovery Resource",
      "sdo:name": "Tracking ghost gear and Recovery Resource",
      "sdo:description": "In the gulf of Gabès in Tunisia, fishing gear and nets are actually considered as one of the major problems of plastic pollution. Despite its high productivity and ecological importance, this gulf houses the third highest number of operational fishing vessels of all the Mediterranean regions. The area is subject to strong fishing pressure and about 52% of the Tunisian fishing fleet, contributing to almost 40% of the national fish production. Here lost or abandoned fishing equipment continue capturing fish and other animals. CLEAR Med aims to codesign solutions  to be part of the change. Through citizen sciences and AI we will identify and to quantify the impact of ghost fishing. we will integrate sensors and advanced technologies for preventing loss and retrieving ghost gear. Raising awareness of all stakeholders and sharing best practices between partners will be part of the solution",
      "sdo:location": "Tunisia",
      "sdo:identifier": "7.7",
      "sdo:url": "https://oceandecade.org/actions/tracking-ghost-gear-and-recovery-resource/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Faculty of Sciences of Sfax"
      },
      "sdo:keywords": [
