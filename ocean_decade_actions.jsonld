    {
      "@id": "https://purl.org/oceandecade/decadeactions/25.3",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Polar Ecosystems, Global Impacts (BIOPOLE)",
      "sdo:name": "Polar Ecosystems, Global Impacts (BIOPOLE)",
      "sdo:description": "BIOPOLE will address a fundamental aspect of the Earth System; how nutrients in polar waters drive global carbon (C) cycling and primary productivity. Ocean ecosystems absorb atmospheric CO2, mitigating large amounts of manmade C. However, this part of the global C cycle relies on an adequate supply of nutrients, primarily from the polar regions. BIOPOLE will improve our ability to quantify this export and determine its sensitivity to climate change by addressing three major questions: 1 What physical, chemical and biological processes modify nutrient balance en route from source to polar ocean ecosystems, and how sensitive are they to climate change? 2 What influences do ecosystem processes have on nutrient balance and movement of C to depth in polar oceans, and how may this change in the future? 3 How may movement of C to depth and export of nutrients change in the future, and what impacts will this have on global ocean fish stocks and global C cycling?",
      "sdo:location": "United Kingdom of Great Britain and Northern Ireland (UK)",
      "sdo:identifier": "25.3",
      "sdo:url": "https://oceandecade.org/actions/polar-ecosystems-global-impacts-biopole/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "NERC British Antarctic Survey"
      },
      "sdo:keywords": [
