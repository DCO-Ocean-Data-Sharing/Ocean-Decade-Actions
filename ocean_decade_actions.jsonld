    {
      "@id": "https://purl.org/oceandecade/decadeactions/6.5",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Nutrient Pollution – Global Action Network",
      "sdo:name": "Nutrient Pollution – Global Action Network",
      "sdo:description": "NP-GAN will catalyse action to address nutrient and wastewater pollution impacts on ocean ecosystems and human health focusing on (but not limited too) agrochemical run-off of fertilizers and sewage/domestic wastewater. This program will go beyond the traditional approaches for nutrient mitigation, looking to facilitate innovative solutions integrating new technology, data and society. This will be achieved by building the tools, knowledge, and capacity to evaluate source, fate, and impacts of land-based sources of pollution and by providing best-practice guidance and recommendations for solutions. NP-GAN will harmonise knowledge from existing programs to develop a toolbox of pragmatic, cost-effective methods, guidelines and tools for monitoring, assessment, and mitigation activities.  We bring extensive experience across temperate and tropical systems in addressing nutrient and wastewater pollution for the benefit of marine ecosystems, human health and coastal communities.",
      "sdo:location": "United Kingdom of Great Britain and Northern Ireland (UK)",
      "sdo:identifier": "6.5",
      "sdo:url": "https://oceandecade.org/actions/nutrient-pollution-global-action-network/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Centre for Environment, Fisheries and Aquaculture Science"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Programme",
          "sdo:description": "A Programme is typically global or regional in scale and contributes to the achievement of one or more of the Decade Challenges. It is long-term (multi-year), interdisciplinary, and consists of component Decade Projects and potentially enabling Decade Activities.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
