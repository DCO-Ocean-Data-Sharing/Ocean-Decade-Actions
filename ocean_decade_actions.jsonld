          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ]
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/152.2",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Addressing Precip. Prediction Grand Challenge (PPGC)",
      "sdo:name": "Addressing Precip. Prediction Grand Challenge (PPGC)",
      "sdo:description": "Impacts from extreme precipitation are deadly, damaging, and increasing in a warming climate. Knowing when it will rain and how much is crucial to every person and business globally. The strategic goal of the PPGC Ocean Observation and Science Project is to provide dramatically more accurate, reliable, and timely precipitation forecasts for society. This is accomplished through 1) better understanding of the ocean-atmosphere interface and atmospheric teleconnections, 2) more and better observations of the ocean and atmosphere over oceans, and 3) the development, improvement and application of a fully coupled Earth System prediction model. Focus is placed on better observing, understanding, and modeling the tropical Pacific and Caribbean, benefitting SIDS with improved short term forecasts, and N. American and European nations with improved medium range to sub-seasonal precipitation predictions. These advances in precipitation prediction can be integrated into early warning systems.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "152.2",
      "sdo:url": "https://oceandecade.org/actions/addressing-precip-prediction-grand-challenge-ppgc/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "National Oceanic and Atmospheric Administration (NOAA)"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Contribution",
          "sdo:description": "A Contribution is a one-off standalone initiative (such as an awareness-raising event, a scientific workshop, a training opportunity or a publication). It enables a Decade Programme or Project, or directly contributes to a Decade Challenge.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
