    {
      "@id": "https://purl.org/oceandecade/decadeactions/51.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Aprender Explorando",
      "sdo:name": "Aprender Explorando",
      "sdo:description": "The educational program \"Aprender Explorando\" (AE) - Learning by Exploring connects the expeditions of the sailboats Vinson of Antarctica and Amundsen across the Atlantic and the Southern Ocean with educational centers. It uses the ocean, polar regions, and sailing as the central theme to address various educational content. It is aimed at teachers and students aged 9 to 17. To maximize the potential of the sailboats and their routes in sparsely explored areas, we aim to form strategic alliances with initiatives like Plankton Planet (PP) to collect data on the ocean microbiome during the voyages of both vessels. These data will contribute to understanding and modeling plankton ecosystems in the navigation zones. Aware of current environmental challenges and inspired by the interaction between sailing, science and nature, we seek for this educational program to contribute to the conservation and protection of the oceans.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "51.8",
      "sdo:url": "https://oceandecade.org/actions/aprender-explorando/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Drake Enterprise Foundation - Nicolas Ibañez Scott"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
