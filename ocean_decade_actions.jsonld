    {
      "@id": "https://purl.org/oceandecade/decadeactions/69.2",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Integrated Ocean Observing System for New Zealand",
      "sdo:name": "Integrated Ocean Observing System for New Zealand",
      "sdo:description": "The NZ-OOS is a bottom-up community-driven initiative and its success depends on a joint, inclusive approach. It is possible that NZ can be among the world leaders in the integration of traditional knowledge with western science into an NZ-OOS. It has six high-level themes: 1. Land-sea connectivity and associated stressors (e.g., sedimentation, contaminants).  2. Coastal and bluewater carbon budgets.  3. Sustainable extraction of marine resources (e.g., seabed mining, tidal energy).  4. Sustainable seafood sector including both wild caught fisheries and aquaculture.  5. Multi-scale drivers and response of the ocean state.  6. Maritime safety and transport optimization",
      "sdo:location": "New Zealand",
      "sdo:identifier": "69.2",
      "sdo:url": "https://oceandecade.org/actions/Integrated-Ocean-Observing-System-for-New-Zealand/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "National Institute of Water and Atmospheric Research"
      },
      "sdo:keywords": [
