    {
      "@id": "https://purl.org/oceandecade/decadeactions/18.4",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "The Observatory of Mangrove and its Maretories",
      "sdo:name": "The Observatory of Mangrove and its Maretories",
      "sdo:description": "The Amazonian mangroves occupy about 80% of Brazilian mangroves. Approximately 85% of these mangrove areas are within a conservation unit. Peruvian mangroves are a unique blue forest. Among the main challenges for the governance of this Socio-Ecological System are gaps in the participatory monitoring; limitations in understanding between local scientific and traditional knowledge, and lack of articulation between government initiatives and local community for public policies. Mangrove Observatory intends to strengthen the environmental governance through the creation of a Citizen Science-based Monitoring System that allows the generation of big data and will be built using participatory GIS for the governance of big data based on a citizen science approach through the creation of groups “Mangrove Researchers”. “Mangrove Reporters”. and Laboratory of Experimentation in Citizen Innovation of the Mangrove.",
      "sdo:location": "Brazil",
      "sdo:identifier": "18.4",
      "sdo:url": "https://oceandecade.org/actions/the-observatory-of-mangrove-and-its-maretories/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Organização da Sociedade Civil (OSC) Sarambuí"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
