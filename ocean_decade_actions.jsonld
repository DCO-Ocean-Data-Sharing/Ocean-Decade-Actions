    {
      "@id": "https://purl.org/oceandecade/decadeactions/65.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "COSEA Exploring our Seas & Coasts for Science",
      "sdo:name": "COSEA Exploring our Seas & Coasts for Science",
      "sdo:description": "COSEA is a collaborative, participatory, and community-driven project running on the SPOTTERON Citizen Science App Platform. COSEA is the outcome of two projects, funded by the European Union under the Horizon Europe programme: TRANSEATION and EFFECTIVE. With COSEA, participants can observe marine environments, document coastal habitats or species, report on pollution, infrastructure, human impact, water quality, weather and climate impacts. With participants' contributions on the map and the activity in the App, this helps scientists to better understand the impacts and the drivers of marine factors to protect and foster a healthy relationship between humans and our Seas & Ocean.  The COSEA App is designed as an open platform for project collaboration now and beyond 2030. This means that initiatives, organizations, science projects or even small groups of ocean activists can join up and co-use the App toolkit to co-create COSEA together. More information: https://www.cosea.app/",
      "sdo:location": "Austria",
      "sdo:identifier": "65.9",
      "sdo:url": "https://oceandecade.org/actions/cosea-exploring-our-seas-coasts-for-science/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "SPOTTERON Citizen Science App Platform"
      },
      "sdo:keywords": [
