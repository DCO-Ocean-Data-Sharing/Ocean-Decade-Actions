    {
      "@id": "https://purl.org/oceandecade/decadeactions/180",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Indigenous People, Traditional Ecological Knowledge, and Climate Change: The Iconic Underwater Cultural Heritage of Stone Tidal Weirs",
      "sdo:name": "Indigenous People, Traditional Ecological Knowledge, and Climate Change: The Iconic Underwater Cultural Heritage of Stone Tidal Weirs",
      "sdo:description": "The underwater cultural heritage of stone tidal weirs is a sustainable, eco-friendly fishing practice, made of numerous rocks, which is located along the shoreline on a colossal scale. They are built in various shapes and styles to catch certain fish at certain times of the year. Many extant examples remain and provide a tangible link to the sustainable fishing practice that have incorporated traditional ecological knowledge, and the spirit world, providing balance and harmony for indigenous people for thousands of years. Today these weirs are not just relic examples of the past, but as a guide in future sustainable marine ecological conservation.",
      "sdo:location": "Japan",
      "sdo:identifier": "180",
      "sdo:url": "https://oceandecade.org/actions/Indigenous-People-Traditional-Ecological-Knowledge-and-Climate-Change-The-Iconic-Underwater-Cultural-Heritage-of-Stone-Tidal-Weirs/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Tokyo University of Marine Science and Technology [UNESCO UNITWIN Network for Underwater Archaeology]"
      },
