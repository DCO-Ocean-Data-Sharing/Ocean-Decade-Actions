      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/80.4",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Seascape Alaska, a regional coastal and ocean mapping campaign",
      "sdo:name": "Seascape Alaska, a regional coastal and ocean mapping campaign",
      "sdo:description": "The U.S. waters off of Alaska are a vital part of the global navigation system and are also host to extensive fisheries and other resources, but as of January 2022, 69% of these waters are unmapped. This project seeks to acquire and deliver a high-resolution digital representation of the seafloor beneath these waters to benefit a wide-range of both domestic and international stakeholders that depend on these data. This project brings government and non-government sectors together to share mapping plans and advance technical innovations to more efficiently map and characterize the area in support of Seabed 2030.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "80.4",
      "sdo:url": "https://oceandecade.org/actions/seascape-alaska-a-regional-coastal-and-ocean-mapping-campaign/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "NOAA"
      },
      "sdo:keywords": [
