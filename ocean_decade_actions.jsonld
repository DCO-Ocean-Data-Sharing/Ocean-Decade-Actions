    {
      "@id": "https://purl.org/oceandecade/decadeactions/28.2",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Global Fund for Coral Reefs",
      "sdo:name": "Global Fund for Coral Reefs",
      "sdo:description": "Co-led by the United Nations Capital Development Fund (UNCDF), the United Nations Development Programme (UNDP), and the United Nations Environment Programme (UNEP), the Global Fund for Coral Reefs (GFCR) is the world’s leading multilateral coral reef finance platform, mobilising public and private capital toward the protection and effective management of the world’s most climate-resilient reef systems. Backed by a public-private coalition of states, UN agencies, financial institutions, philanthropies, impact investors, conservation actors, and civil society, GFCR blends grants, concessional and risk-tolerant instruments, and private investment to help shift markets toward reef-positive outcomes across 22 coral nations. By 2030, GFCR aims to support at least 400 business and finance solutions, improve management across 3 million hectares of climate-resilient reefs, and contribute to strengthened resilience for 20 million people.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "28.2",
      "sdo:url": "https://oceandecade.org/actions/Global-Fund-for-Coral-Reefs/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "United Nations Multi-Partner Trust Fund Office"
      },
      "sdo:keywords": [
