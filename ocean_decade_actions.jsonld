    {
      "@id": "https://purl.org/oceandecade/decadeactions/34.3",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Ocean World of Sound: MesoAmerican Reef",
      "sdo:name": "Ocean World of Sound: MesoAmerican Reef",
      "sdo:description": "“Ocean World of Sound: MesoAmerican Reef” is focused on understanding and celebrating the soundscape of the MesoAmerican Reef system. Our work includes developing, implementing, and refining methodologies for sound recording, listening station infrastructure, data exploration and analysis, citizen science, and incorporation of soundscape analysis and management into Marine Protected Area protocol and strategy. We embrace a transdisciplinary integrative approach that incorporates perspectives from multiple sciences as well as arts and humanities, and engages with local cultural traditions and perspectives. Our goal is to support understanding, respect, and resiliency of the MesoAmerican Reef System, while providing a model for soundscape research globally.",
      "sdo:location": "Mexico",
      "sdo:identifier": "34.3",
      "sdo:url": "https://oceandecade.org/actions/ocean-world-of-sound-mesoamerican-reef/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Ocean World of Sound"
      },
