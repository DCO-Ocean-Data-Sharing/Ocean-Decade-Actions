    {
      "@id": "https://purl.org/oceandecade/decadeactions/6.1",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Bio-GO-SHIP: Observing Life in the High Seas",
      "sdo:name": "Bio-GO-SHIP: Observing Life in the High Seas",
      "sdo:description": "Bio-GO-SHIP is an international collaboration using repeat hydrographic sections to understand deeply the link between the physio-chemical ocean environment and global plankton diversity, abundance, and biogeochemical roles amidst ocean change. Its mission is to quantify plankton diversity, size, composition, and abundance across vast spatial and vertical scales. This is achieved via systematic, high-quality sampling using standardized 'omics, imaging, particle chemistry, and optical techniques, integrated with regular GO-SHIP physical/chemical data. This integration allows for predicting how plankton respond to change and their feedback on carbon, oxygen, and nutrient cycles. Benefits include generating a uniform, publicly available global plankton dataset using vetted methods, coincident with GO-SHIP data, and training a new cohort in these advanced oceanographic approaches.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "6.1",
      "sdo:url": "https://oceandecade.org/actions/bio-go-ship-observing-life-in-the-high-seas/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "University of California, Irvine"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
