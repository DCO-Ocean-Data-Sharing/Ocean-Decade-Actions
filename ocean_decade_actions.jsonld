    {
      "@id": "https://purl.org/oceandecade/decadeactions/60.6",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Textile X Ocean Connector Project",
      "sdo:name": "Textile X Ocean Connector Project",
      "sdo:description": "The Textile X Ocean Connector Project was developed to address critical issues and foster solutions at the intersection of textile sustainability and the global ocean through experiential learning and cross sector connection. The thoughtfully curated programs foster deep connections between attendees and help to answer hard questions about textile-derived ocean pollution (i.e. microfiber pollution), climate change, waste, green chemistry, material alternatives, and more. Related programming includes facilitated discussions, expert presentations, research demonstrations, and prioritization of solutions, all while sailing or outside in the San Francisco area and beyond. Participants include sustainability professionals, textile industry professionals, ocean researchers, students, educators, local policy leaders, and indigenous peoples. Since 2022, the Textile X Ocean Connector Project brought together more than 150 individuals annually from a range of sectors and stakeholder groups.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "60.6",
      "sdo:url": "https://oceandecade.org/actions/textile-x-ocean-connector-project/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
