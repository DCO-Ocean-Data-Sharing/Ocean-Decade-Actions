      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/10.1",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Marine Innovation Hub - Ghana",
      "sdo:name": "Marine Innovation Hub - Ghana",
      "sdo:description": "The Marine Innovation Hub - Ghana is a collaborative initiative dedicated to the advancement of climate mitigation efforts across the West African coastline. In partnership with stakeholders across the West Africa, the Hub aims to democratize knowledge on ocean-based efforts to help address the growing impacts of climate change. With our positionality in Ghana, the Hub will bring together a diverse community of academia, government, local communities and NGOs to work towards a common goal of ocean action and preservation. The Hub's primary mission is to identify, support and collaborate with relevant partners to design and implement ocean initiatives including marine carbon removal techniques. Through this codependent approach, the Hub aims to aid in the compilation of research, the democratization of knowledge on ocean initiatives, the development of practical interventions and the implementation of scalable solutions focus on enhancing climate resilience.",
      "sdo:location": "Ghana",
      "sdo:identifier": "10.1",
      "sdo:url": "https://oceandecade.org/actions/marine-innovation-hub-ghana/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Emerging Climate Frontiers"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/172"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/11.1",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Blue Guard Alliance TCI",
      "sdo:name": "Blue Guard Alliance TCI",
      "sdo:description": "Blue Guard Alliance TCI will transform fisheries governance in the Turks and Caicos Island, a SIDS through climate-resilient, community inclusive management. The project deploys digital data collection, VMS, e-licensing and will establishes the Caribbean's first national environmental DNA (eDNA) biodiversity observatory aligned with OBON standards. Six components deliver: (1) real-time VMS and catch data; (2) eDNA-based species and habitat mapping for MPAs and TACs; (3) modernized fisheries legislation and operationalized Fisheries Management Plan; (4) Local Fisheries Management Committees and ocean literacy; (5) blue economy pilots (lobster casitas, FADs, traceability); (6) regional knowledge exchange. Targeting queen conch, spiny lobster and finfish upon which 40,000+ people depend, the project co-produces data-driven solutions with fishers, women, youth and agencies, positioning TCI as a SIDS leader in technology-enabled, equitable ocean stewardship under FishSCORE 2030 and OBON.",
      "sdo:location": "United Kingdom of Great Britain and Northern Ireland (UK)",
      "sdo:identifier": "11.1",
      "sdo:url": "https://oceandecade.org/actions/blue-guard-alliance-tci/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Gulf of Maine Research Institute – United States of America (USA)"
      },
      "sdo:keywords": [
        {
