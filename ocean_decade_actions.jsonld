    {
      "@id": "https://purl.org/oceandecade/decadeactions/67.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Silent Depth under the Arctic Ocean",
      "sdo:name": "Silent Depth under the Arctic Ocean",
      "sdo:description": "\"Silent Depth under the Arctic Ocean\" is a science-sailing initiative by PVO Expeditions in collaboration with Tarevoktere to address Arctic kelp forest decline. Through bi-annual expeditions in northern Norway, we will map kelp density, test urchin-removal techniques, and document restoration efforts. The project blends research, exploration, and media to generate open-access data, visual content, and policy advocacy. The aim is to raise awareness of the hidden crisis facing Arctic marine ecosystems, engage local and global communities, and contribute to long-term kelp forest regeneration and climate resilience.",
      "sdo:location": "Denmark",
      "sdo:identifier": "67.9",
      "sdo:url": "https://oceandecade.org/actions/silent-depth-under-the-arctic-ocean/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "PVO Expeditions"
      },
      "sdo:keywords": [
