      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/57.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Submarine Geological Hazards and Digitization",
      "sdo:name": "Submarine Geological Hazards and Digitization",
      "sdo:description": "This project, part of the Digital Deep-sea Typical Habitats Programme (Digital DEPTH), addresses UN Sustainable Development Goals 7, 11, 13, and 14. The SubSEA Dig project targets submarine areas vulnerable to human activities and global changes, aiming to enhance early warning and risk management of geological hazards through digital technologies. By studying hazard formation mechanisms via observations and lab analysis, it enables digital modeling and simulation to improve monitoring accuracy and early warning. A digital platform will also integrate global data, analyses, and findings, advancing research and supporting sustainable marine development.",
      "sdo:location": "China",
      "sdo:identifier": "57.8",
      "sdo:url": "https://oceandecade.org/actions/submarine-geological-hazards-and-digitization/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Ocean University of China"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/12.4"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/60.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Towards sustainable coastal marine ecosystems",
      "sdo:name": "Towards sustainable coastal marine ecosystems",
      "sdo:description": "Tropical coastal marine ecosystems such as coral reefs, seagrass meadows, and mangroves play a central role in hosting biodiversity and provide many ecosystem services to human societies, but suffer from global changes and are declining. The objective of the Track Changes project is to evaluate the response of coastal marine ecosystems to environmental changes and elucidate mechanisms underlying resilience, using the exceptional coastal system of New Caledonia as a study model. The project follows two complementary scientific investigation routes, one looking to the past using available historical data, the other to the future with the development of innovative technology. A third route, more institutional in nature, is dedicated to assisting decision-making based on the project outcomes. This highly collaborative initiative unites contribution from various local societal actors and international academia, building an empiric foundation for implementing sustainable coastal management.",
      "sdo:location": "France",
      "sdo:identifier": "60.8",
      "sdo:url": "https://oceandecade.org/actions/towards-sustainable-coastal-marine-ecosystems/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Institut de Recherche pour le Développement (IRD)"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
