    {
      "@id": "https://purl.org/oceandecade/decadeactions/18.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "The Coral Microbiome Initiative",
      "sdo:name": "The Coral Microbiome Initiative",
      "sdo:description": "CoralGuard is a pioneering initiative in Southwest Madagascar to combat coral reef degradation using a groundbreaking probiotic approach. Focusing on the critically endangered Grand Récif de Toliara, the action moves beyond monitoring to proactive, science-based intervention. It will isolate beneficial bacteria from resilient local corals to develop a targeted probiotic consortium, \"CoralProbio-Tulear.\" This treatment will be rigorously tested to enhance coral survival and growth in degraded areas, aiming to significantly improve the success of restoration efforts. By integrating microbiome science with local management, CoralGuard provides a novel, sustainable tool to bolster reef resilience, protect biodiversity, and secure the vital ecosystem services upon which coastal communities depend.",
      "sdo:location": "Madagascar",
      "sdo:identifier": "18.9",
      "sdo:url": "https://oceandecade.org/actions/the-coral-microbiome-initiative/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Marine Sciences & Resources Institute (IHSM)"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
