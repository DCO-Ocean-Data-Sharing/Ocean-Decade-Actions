    {
      "@id": "https://purl.org/oceandecade/decadeactions/153.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Flautistas da Marambaia",
      "sdo:name": "Flautistas da Marambaia",
      "sdo:description": "The \"Flautistas da Marambaia\" project promotes musical education and environmental awareness in Restinga da Marambaia, Barra de Guaratiba, West Zone of Rio de Janeiro. Started at Escola Municipal Professor Vieira Fazenda, located between the sea and mangroves, it now operates from its own premises. Serving 50 children annually, the project focuses on local communities with low Human Development Index. Part of the Blue School program supported by MCTI, it aims to foster Ocean Culture, raising awareness about aquatic ecosystems and their preservation. Since 2002, it has reached around 1,200 children. The initiative received the Light in Schools award in 2020 and the Mostra de Multilinguagens from the Rio de Janeiro Department of Education, with over 12 years of experience in environmental and cultural education.",
      "sdo:location": "Brazil",
      "sdo:identifier": "153.9",
      "sdo:url": "https://oceandecade.org/actions/flautistas-da-marambaia/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
