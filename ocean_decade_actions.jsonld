    {
      "@id": "https://purl.org/oceandecade/decadeactions/54",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "The Current V: Ancestral Ocean",
      "sdo:name": "The Current V: Ancestral Ocean",
      "sdo:description": "This phase on The Current will focus on oceanic kinships, cultural languages, embodied legacies, ancestral memory, and marine historiographies within the Indian Ocean World, with a particular emphasis on island geographies connecting Afrasian pasts, presents, and futures. Working alongside artists, scientific researchers, musicians, writers, and poets, this initiative will continue a decade-long trajectory of individual and collaborative practices unfolding across the waterways of the Indian Ocean.",
      "sdo:location": "Italy",
      "sdo:identifier": "54",
      "sdo:url": "https://oceandecade.org/actions/the-current-iii-the-mediterranean-waves-come-in-pairs/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "TBA21-Academy"
      },
