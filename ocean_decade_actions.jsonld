    {
      "@id": "https://purl.org/oceandecade/decadeactions/151.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Deep Ocean Microbial Symbionts",
      "sdo:name": "Deep Ocean Microbial Symbionts",
      "sdo:description": "The DOMS project will contribute to the DOME Programme by advancing our understanding of deep-ocean microbial symbionts, which are fundamental to the survival, adaptation, and ecological success of marine life in Earth's largest and least explored biome. It will: (1) employ cutting-edge technologies to discover and characterize the taxonomic and functional diversity of microbial symbionts associated with diverse deep-sea fauna, aiming to uncover novel genes and adaptive strategies; (2) elucidate the ecological significance and biogeochemical roles of symbiotic interactions, focusing on nutrient cycling, host physiological contributions, and environmental factors on holobiont stability and functionality; (3) investigate the interplay within holobionts, including the roles of viruses in shaping symbiont communities and host health; and (4) ensure all generated data and knowledge are openly shared via the OceanMicrobe platform, supporting DOME's commitment to the BBNJ Agreement.",
      "sdo:location": "China",
      "sdo:identifier": "151.9",
      "sdo:url": "https://oceandecade.org/actions/deep-ocean-microbial-symbionts/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "BGI-Research, Qingdao"
      },
