      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/51.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Pampa Azul Bonaerense",
      "sdo:name": "Pampa Azul Bonaerense",
      "sdo:description": "The PAB is a provincial governmental initiative designed to foster new society-nature relationships through strategic planning, territorial management, and environmental education. It integrates citizen participation, citizen science, public education, and aims to shift coastal governance toward more integrated, knowledge-based models. Additionally, it involves artisanal fishing communities, tourism stakeholders, local communities, and governmental actors to facilitate informed decisions, cultural transformation, and territorial sustainability. PAB directly contributes to several key priorities outlined in the Barcelona Declaration through its comprehensive approach to marine-coastal ecosystem management. The PAB revolves around six strategic axes: ecosystem conservation, spatial planning, pollution control and circular economy, climate change adaptation, environmental monitoring, and citizen participation.",
      "sdo:location": "Argentina",
      "sdo:identifier": "51.9",
      "sdo:url": "https://oceandecade.org/actions/pampa-azul-bonaerense/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Ministry of Environment of the Province of Buenos Aires, Argentina"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/90"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/53.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Sea Too",
      "sdo:name": "Sea Too",
      "sdo:description": "Humans use natural resources faster than they can renew themselves. Nature loss is advancing fast – also underwater. The Sea Too project aims to restore ecologically significant Baltic Sea ecosystems, strengthen the human–sea relationship, and enhance cooperation among stakeholders in the region. The goal of the Sea Too project is to change the unsustainable ways of using ocean resources, which requires both hands-on restoration work and a shift in people’s thinking and acting. In the Sea Too project, spanning across the Baltic Sea, underwater habitats and key species that have weakened due to anthropogenic stressors are restored. The work builds upon scientific research on ecosystems, prior experience, local knowledge, and citizen science. At restoration sites, workshops explore local ecological and cultural knowledge of the sea. Working with scientists and artists, the project invites people to emotionally connect with the human-sea relationship.",
      "sdo:location": "Finland",
      "sdo:identifier": "53.9",
      "sdo:url": "https://oceandecade.org/actions/sea-too/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "John Nurminen Foundation"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/90"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/55.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "AI for Oceanic Seamless Forecast",
      "sdo:name": "AI for Oceanic Seamless Forecast",
      "sdo:description": "The Northwestern Pacific faces frequent disasters, but its complex ocean dynamics and air-sea interactions hinder traditional ocean models. With growing ocean and atmospheric data volumes, artificial intelligence (AI) provides a powerful means to boost forecast accuracy and timeliness. This initiative seeks to advance seamless forecasting for the region via AI-driven models by: 1)Collecting comprehensive oceanic and atmospheric data to establish a data-sharing platform. 2)Developing a cutting-edge AI large model enabling seamless forecasting across multi-temporal scales. 3)Establishing a forecasting system to provide services to support marine management, disaster prevention. 4)Building an international cooperation platform to promote seamless forecasting and marine disaster response. The initiative aims to enhance the Northwester Pacific’s resilience to marine hazards and drive collective progress in ocean science and governance.",
      "sdo:location": "China",
      "sdo:identifier": "55.9",
      "sdo:url": "https://oceandecade.org/actions/ai-for-oceanic-seamless-forecast/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Nanjing University of Information Science and Technology"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
