      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/55.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Action Plan for the Ocean",
      "sdo:name": "Action Plan for the Ocean",
      "sdo:description": "Developing an Action Plan for the Ocean  Recent years have seen the generation of extensive international assessments of ocean change and future risks. We propose the development of an Action Plan for the Ocean to respond to these changes and risks.  This will involve a risk-based approach with three major components:  (1) assess and rank risks, (2) identify options for action, and (3) develop action plans for adaptation at local, regional and global scales to respond to future change.",
      "sdo:location": "Australia",
      "sdo:identifier": "55.8",
      "sdo:url": "https://oceandecade.org/actions/action-plan-for-the-ocean/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "CSIRO Environment"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
