    {
      "@id": "https://purl.org/oceandecade/decadeactions/70.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Thinking Beyond The Tides",
      "sdo:name": "Thinking Beyond The Tides",
      "sdo:description": "Thinking Beyond the Tides is a prestigious 7-month hybrid annual ocean literacy fellowship empowering Caribbean leaders aged 18–35 to become marine conservation champions. Combining theoretical and hands-on learning, the program focuses on nature-based solutions, ecosystem restoration, and regional collaboration to enhance climate resilience. Fellows develop leadership skills, engage in biodiversity conservation initiatives, and gain mentorship from industry leaders, alongside access to career development resources, internships, and networking opportunities. By fostering environmental stewardship and professional growth, *Thinking Beyond the Tides* aims to cultivate a new generation of ocean stewards dedicated to safeguarding the Caribbean's marine ecosystems and communities.",
      "sdo:location": "Trinidad and Tobago",
      "sdo:identifier": "70.8",
      "sdo:url": "https://oceandecade.org/actions/thinking-beyond-the-tides/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
