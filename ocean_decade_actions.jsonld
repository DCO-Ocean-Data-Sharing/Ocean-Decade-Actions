    {
      "@id": "https://purl.org/oceandecade/decadeactions/133",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Promote Seabed 2030 and Ocean Mapping",
      "sdo:name": "Promote Seabed 2030 and Ocean Mapping",
      "sdo:description": "The Decade Programme â€˜Promote Seabed 2030 and Ocean Mapping' contributes to the development of a comprehensive digital representation of the ocean. Only 20 percent of the world's ocean is mapped to modern standards, and many parts of the ocean are not surveyed comprehensively with modern multibeam sonar.  A full map of the ocean is a crucial starting point for the desired outcomes of the Decade, and failure to produce an adequate map prevents us from globally achieving the \"ocean we want.â€",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "133",
      "sdo:url": "https://oceandecade.org/actions/Promote-Seabed-2030-and-Ocean-Mapping/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
