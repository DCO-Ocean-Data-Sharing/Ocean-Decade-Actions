    {
      "@id": "https://purl.org/oceandecade/decadeactions/16.3",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Protection and sustainable use of marine areas (sustainMare)",
      "sdo:name": "Protection and sustainable use of marine areas (sustainMare)",
      "sdo:description": "The DAM research mission “sustainMare” analyses and classifies the use of and the pressures on marine spaces in such a way, that a scientifically sound basis is created for decisions by politics, authorities and the economy.  A broad-based transdisciplinary research approach is chosen. More than 250 researchers in two pilot projects and five research networks are investigating the ecological, economic and social impacts of human use and pollution in North and Baltic Sea with a specific focus on the German Exclusive Economic Zone and German coastal waters. The provision of concrete options for action and consistent implementation of measures for knowledge transfer and data provision are intended to ensure the subsequent use of the results in politics and society.  The aim of the research mission is to develop options for sustainable use of marine resources and ecosystem services that will support the achievement of the EUs target of a Good Environmental Status (GES).",
      "sdo:location": "Germany",
      "sdo:identifier": "16.3",
      "sdo:url": "https://oceandecade.org/actions/protection-and-sustainable-use-of-marine-areas-sustainmare/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Helmholtz-Zentrum Hereon / Institute of Coastal Systems - Analysis and Modeling"
      },
