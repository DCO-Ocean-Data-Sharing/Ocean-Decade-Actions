    {
      "@id": "https://purl.org/oceandecade/decadeactions/130.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "ALAN and Warming Impacts on Marine Interactions",
      "sdo:name": "ALAN and Warming Impacts on Marine Interactions",
      "sdo:description": "Light pollution is a growing threat to coastal habitats worldwide and is increasing in intensity and extent at an unprecedented rate. Increasingly, however, coastal ecosystems are exposed to multiple stressors, which can co-occur and have additive or interactive effects. Understanding interactions between light pollution and ocean warming on marine species – both widespread stressors that impact important sensory cues and biological processes – allows managers to prioritise sensitive areas and can buffer marine habitats against the forecasted impacts from climate change. By assessing impacts from microbes to seaweeds, sea urchins and fish, this project provides a holistic understanding of how ALAN – independently and combined with other stressors – impacts the marine environment and the consequences to ecosystem functioning and the future provision of key services.",
      "sdo:location": "Australia",
      "sdo:identifier": "130.9",
      "sdo:url": "https://oceandecade.org/actions/alan-and-warming-impacts-on-marine-interactions/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "University of New South Wales"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/3.7"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/140.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Food Conveyor Belts in the Ocean",
      "sdo:name": "Food Conveyor Belts in the Ocean",
      "sdo:description": "The biomass of small fish, crustaceans, squids, and gelatinous zooplankton hiding in the twilight of the mesopelagic zone is estimated to be about 20 times greater than all other fish in the ocean combined. These organisms, small and dispersed across vast ocean volumes, often drift passively with ocean currents. Yet we still do not know how this vast biomass moves horizontally or enters the food chains of shallower ecosystems. In this Decade Action, we aim to uncover the mechanisms that determine when and where prey from the open ocean become available to predators. We will map these foraging hotspots across the North Atlantic and predict how advected biomass shapes productivity, life-history strategies, and species distributions in the receiving ecosystems. Understanding these dynamics is crucial for predicting ecosystem change, guiding management, advancing sustainable unfed aquaculture, and improving carbon flux estimates by identifying areas critical for long-term carbon storage.",
      "sdo:location": "Norway",
      "sdo:identifier": "140.9",
      "sdo:url": "https://oceandecade.org/actions/food-conveyor-belts-in-the-ocean/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "University of Bergen, Department of Biological Sciences"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
      ],
      "sdo:memberOf": {
        "@id": "https://purl.org/oceandecade/decadeactions/189"
      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/141.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Ocean Data Tapestry International Forum",
      "sdo:name": "Ocean Data Tapestry International Forum",
      "sdo:description": "The Ocean Data Tapestry International Forum (ODTIF) is a multidisciplinary initiative that integrates technology, science, and art to address marine pollution. Co-founded by ELSETECH Environment Inc. and Korea Institute of Geoscience and Mineral Resources (KIGAM), the project focuses on collecting and analyzing pollution information from rivers to coastal areas. This data is used to build GIS-based pollution maps and trace pollution sources. ODTIF extends its impact through collaboration with international partners and uses artistic expression from Art Farm LK to engage civil society and drive behavioral change. The project also promotes a circular economy by developing a system to recycle collected filters. As a proposed Decade Action, ODTIF aims to contribute to Challenges 1, 8, and 10 of the UN Ocean Decade, offering a model for how scientific knowledge can be effectively translated into policy and public engagement.",
      "sdo:location": "Republic of Korea",
      "sdo:identifier": "141.9",
      "sdo:url": "https://oceandecade.org/actions/ocean-data-tapestry-international-forum/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Elsetech Environment Inc."
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
          "sdo:description": "A Project is a targeted regional, national, or subnational initiative that typically contributes to an identified Decade Programme.",
          "sdo:inDefinedTermSet": {
            "@type": "sdo:DefinedTermSet",
            "sdo:name": "UN Ocean Decade Action types.",
            "sdo:description": "A definition of the types of Decade Action."
          }
        }
