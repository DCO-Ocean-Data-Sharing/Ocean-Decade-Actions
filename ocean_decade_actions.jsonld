    {
      "@id": "https://purl.org/oceandecade/decadeactions/UN34",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Decade Coordination Office for Connecting People and Ocean",
      "sdo:name": "Decade Coordination Office for Connecting People and Ocean",
      "sdo:description": "The DCO for Connecting People and Ocean will coordinate Decade implementation under Challenge 10 ‘Change humanity’s relationship with the ocean: Ensure that the multiple values and services of the ocean for human wellbeing, culture, and sustainable development are widely understood, and identify and overcome barriers to behaviour change required for a step change in humanity’s relati ’ Their activities will include supporting endorsed Decade Actions, engaging stakeholders, catalysing new Decade Actions, carrying out communications activities, mobilising resources, contributing to monitoring and evaluation, and contributing to capacity development.",
      "sdo:location": "Italy",
      "sdo:identifier": "UN34",
      "sdo:url": "https://oceandecade.org/actions/decade-coordination-office-for-connecting-people-and-ocean/",
