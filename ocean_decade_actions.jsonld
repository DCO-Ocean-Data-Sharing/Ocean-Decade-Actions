    {
      "@id": "https://purl.org/oceandecade/decadeactions/39.7",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Deep Ocean Observation to Predict Climate hazards",
      "sdo:name": "Deep Ocean Observation to Predict Climate hazards",
      "sdo:description": "Oceans play a major role as a modulator of the Earth's global climate system, while holding valuable ecosystems on which we depend.  Eulerian observation systems play a key role, since they have unique capabilities to collect samples and make sustained observations where other systems cannot. Within the years some deep moorings locations was not able to be maintained. The  major challenge in the deep mooring data observation is to protect and restore ecosystems and biodiversity, to enhence Ocean Observations, and to contribute to the  Digital Representation of the Ocean. DeePCMED focuses strengthen deep-sea research observations in Mediterranean Sea and based on collaboration with partners from marine environmental research institutes to clarify the impact of extreme events in deep habitats in Mediterranean Sea on the stability and resilience of marine ecosystems and to construct a  marine ecological environmental prediction system.",
      "sdo:location": "Tunisia",
      "sdo:identifier": "39.7",
      "sdo:url": "https://oceandecade.org/actions/deep-ocean-observation-to-predict-climate-hazards/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Institut National des Sciences et Technologies de la Mer"
      },
      "sdo:keywords": [
