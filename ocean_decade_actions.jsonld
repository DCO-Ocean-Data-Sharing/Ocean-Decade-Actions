    {
      "@id": "https://purl.org/oceandecade/decadeactions/71.7",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Blue Horizon",
      "sdo:name": "Blue Horizon",
      "sdo:description": "The project Blue Horizon, is a project aimed at the identification, prevention, control and reduction of all forms of marine pollution in Nigeria's coastal states. This will be achieved through stakeholders engagement, training and community education and involvement as well as research.",
      "sdo:location": "Nigeria",
      "sdo:identifier": "71.7",
