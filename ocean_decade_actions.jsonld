    {
      "@id": "https://purl.org/oceandecade/decadeactions/46.2",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Women in blue: gender equity for ocean sustainability",
      "sdo:name": "Women in blue: gender equity for ocean sustainability",
      "sdo:description": "Increasing global threats to the ocean requires sustainable actions. Although women’s knowledge and roles for community well-being and in ocean-related activities are key to sustainability, they often have fewer opportunities, undervalued work positions and lower wages, especially in developing countries. The ‘Women in blue: gender equity for ocean sustainability’ project will foster women's empowerment and gender equality in science, fisheries and politics. This will be achieved by: 1)  identifying barriers and solution paths for women participation and leadership in ocean affairs; 2) strengthening the voices of women in fisheries to engage in climate change and policy discussions by facilitating the connection of existing networks across Brazilian coast.",
      "sdo:location": "Brazil",
      "sdo:identifier": "46.2",
      "sdo:url": "https://oceandecade.org/actions/women-in-blue-gender-equity-for-ocean/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
