    {
      "@id": "https://purl.org/oceandecade/decadeactions/UN37",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Ocean Decade Programme Sustainable Ocean Planning (SOP Programme)",
      "sdo:name": "Ocean Decade Programme Sustainable Ocean Planning (SOP Programme)",
      "sdo:description": "The Ocean Decade Programme on SOP has been co-designed and developed to respond to the recommendations of the Ocean Panel’s agenda with regards to achieving 100% of sustainable ocean planning and to leverage the ecosystem of the Ocean Decade particularly in relation to Challenge 4 (develop a sustainable and equitable ocean economy), and fast-track SOP implementation in coastal nations through technical and scientific support. While the high-level purpose of this SOP Programme is to empower nations with the necessary tools and knowledge to develop and implement user-driven, mission-oriented, climate-smart and equitable SOP underpinned by scientific, ILK, the Programme also intends to support transboundary cooperation and enhance capacity development. Thus, the SOP Programme aims to foster a global community of practice, bringing together nations, researchers, and stakeholders to co-create and co-develop tailored, evidence-driven strategies for sustainable ocean use.",
      "sdo:location": "France",
      "sdo:identifier": "UN37",
      "sdo:url": "https://oceandecade.org/actions/ocean-decade-programme-on-sustainable-ocean-planning/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Intergovernmental Oceanographic Commission of UNESCO"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
