    {
      "@id": "https://purl.org/oceandecade/decadeactions/32.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Empowering Msmes in Tanzania Blue Economy",
      "sdo:name": "Empowering Msmes in Tanzania Blue Economy",
      "sdo:description": "The Blue Enterprise Tanzania Project empowers 250 women- and youth-led MSMEs in coastal regions to advance a resilient, inclusive blue economy. Using the GIZ SME Training & Coaching Loop, it generates 750 direct decent jobs (50% women, 40% youth) and 1,250 indirect jobs, alongside workforce gains such as 25% income growth, formal contracts, gender-equitable policies, and health and safety safeguards. The project strengthens 5 ESOs, establishes Blue Economy Centres of Excellence in Dar es Salaam and Zanzibar, and builds MSME capacity in business planning, finance, formalization, technology adoption, market access, and investment readiness. By engaging financial institutions, investors, and government, it shifts perceptions of blue enterprises and fosters investor matchmaking. Aligned with the Ocean Decade vision for science-based, sustainable ocean development, the project seeks endorsement under Call 09/2025 to amplify impact and global collaboration.",
      "sdo:location": "Kenya",
      "sdo:identifier": "32.9",
      "sdo:url": "https://oceandecade.org/actions/empowering-msmes-in-tanzania-blue-economy/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Sote Hub"
      },
