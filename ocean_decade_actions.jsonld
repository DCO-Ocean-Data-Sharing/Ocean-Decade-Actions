    {
      "@id": "https://purl.org/oceandecade/decadeactions/117",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "FAIR Data in the UN Ocean Decade in support of integrated ecosystem assessment",
      "sdo:name": "FAIR Data in the UN Ocean Decade in support of integrated ecosystem assessment",
      "sdo:description": "The UN decade's most pressing need is to find scientifically based management solutions to the existing and future challenges that the ocean, and thus humankind, faces. To move from the present assessments of much of the global ocean based on qualitative interpretations of selective data, to quantitative assessments based on trustworthy and shared data, there needs to be a strengthening of global ocean data collection, - curation, -products and -integration. In FAIROD we focus on capacity building and development of tools for undertaking efficient place-based integrated ecosystem assessments in support of management to ensure sustainable human activities in the ocean.",
      "sdo:location": "Norway",
      "sdo:identifier": "117",
      "sdo:url": "https://oceandecade.org/actions/FAIR-Data-in-the-UN-Ocean-Decade-in-support-of-integrated-ecosystem-assessment/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Institute of Marine Research, Norway"
      },
