    {
      "@id": "https://purl.org/oceandecade/decadeactions/94.6",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Sea Academy+",
      "sdo:name": "Sea Academy+",
      "sdo:description": "The Sea Academy+ project proposes solutions to concurrent biodiversity loss, the decline of marine resources, and food insecurity among coastal communities in Taytay (Philippines). Its objectives are to: 1) expand and strengthen an existing network of marine protected areas, 2) restore coastal and marine ecosystems (mangroves, coral reefs), 3) develop sustainable income-generating activities for fisherfolks, 4) raise awareness in schools and communities about the need to preserve marine ecosystems, 5) support research to improve the management of marine ecosystems.",
      "sdo:location": "Philippines",
      "sdo:identifier": "94.6",
      "sdo:url": "https://oceandecade.org/actions/sea-academy/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Sulubaai Environmental Foundation"
      },
