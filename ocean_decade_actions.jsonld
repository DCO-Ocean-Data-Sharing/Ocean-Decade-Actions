    {
      "@id": "https://purl.org/oceandecade/decadeactions/34.9",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "South Atlantic Ocean biogeochemical estimation",
      "sdo:name": "South Atlantic Ocean biogeochemical estimation",
      "sdo:description": "The lack of oceanographic data from the South Atlantic Ocean is a limiting factor to validate biogeochemical models, which impact the understanding of several ocean processes relevant for coastal communities. Data collected in the southeast coast of Brazil will be used to test the ability of ESPER (Empirical Seawater Property Estimation Routines), trained on global datasets, to estimate biogeochemical variables based on water temperature, salinity and other readily available variables. The state of Rio de Janeiro presents an extensive and diverse coastline ideal for data acquisition (including pristine, degraded, and upwelling areas). The results will identify similarities, differences, and gaps in the application of the ESPER routines on the Brazilian coast compared with global models. Besides, it will evaluate the capacity of these regions to serve as carbon sinks and assess the impacts of climate change. This methodology will be applied for the first time on the Brazilian coast.",
      "sdo:location": "Brazil",
      "sdo:identifier": "34.9",
      "sdo:url": "https://oceandecade.org/actions/south-atlantic-ocean-biogeochemical-estimation/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Universidade Federal Fluminense"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
          "sdo:name": "Decade Project",
