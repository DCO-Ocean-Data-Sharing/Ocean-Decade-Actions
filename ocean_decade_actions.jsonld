    {
      "@id": "https://purl.org/oceandecade/decadeactions/54.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Exploring the Potential of Ocean Blue Carbon",
      "sdo:name": "Exploring the Potential of Ocean Blue Carbon",
      "sdo:description": "This project aims to understand the relationship between the ocean and CO2 integrally and to create innovations for climate change resilience with the maximum use of the ocean’s potential, especially focusing on blue carbon. It investigates the carbon exchange process between the atmosphere, land, and ocean, as well as the ocean response function towards atmospheric CO2 increases. Specifically, three research pillars are set: 1) Clarification of the ocean processes involved in its carbon absorption, storage and sequestration, and the ocean feedback processes according to the carbon cycle due to ocean warming, acidification and deoxygenation; 2) Assessment of the effects on ocean ecosystem services resulted from ocean warming, acidification, and deoxygenation, and their feedback processes according to the carbon cycle and blue carbon; and 3) Development of innovative fundamental technologies to clarify and control the relationship between the ocean and CO2 and blue carbon functioning.",
      "sdo:location": "Japan",
      "sdo:identifier": "54.8",
      "sdo:url": "https://oceandecade.org/actions/exploring-the-potential-of-ocean-blue-carbon/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Atmosphere and Ocean Research Institute, The University of Tokyo"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
