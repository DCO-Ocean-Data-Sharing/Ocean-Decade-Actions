    {
      "@id": "https://purl.org/oceandecade/decadeactions/22.5",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Developing a conservation plan for Maui's corals",
      "sdo:name": "Developing a conservation plan for Maui's corals",
      "sdo:description": "The core of our proposal is to implement workshops, trainings, resort partnerships, and knowledge sharing for coral restoration on Maui. Our project will include habitat monitoring, skill development for Maui Nui Marine Resource Council staff and community members, and hosting virtual and on-site seminars with key partners. We will also work with resorts to develop new financial structures to leverage private funding from the tourism sector to support restoration efforts to sustain long-term coral restoration efforts.",
      "sdo:location": "United States of America (USA)",
      "sdo:identifier": "22.5",
      "sdo:url": "https://oceandecade.org/actions/developing-a-conservation-plan-for-mauis-corals/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "University of California, Santa Cruz"
      },
      "sdo:keywords": [
