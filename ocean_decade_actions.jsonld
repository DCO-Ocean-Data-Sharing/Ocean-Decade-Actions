    {
      "@id": "https://purl.org/oceandecade/decadeactions/149",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Above and beyond - completing the World Register of Marine Species",
      "sdo:name": "Above and beyond - completing the World Register of Marine Species",
      "sdo:description": "The World Register of Marine Species (WoRMS) will continue its endeavours to be able to provide a full taxonomic overview of all marine life, thereby not only supporting scientists, but everyone who makes use of species names, including policy, industry and the public at large. Although already fairly/very complete, taxonomic gaps still need to be addressed, both in space and time. In addition, new challenges in the field of taxonomy need to be explored, thereby looking for the best suitable solution for all WoRMS users. Where relevant, traits information will be further documented.",
      "sdo:location": "Belgium",
      "sdo:identifier": "149",
      "sdo:url": "https://oceandecade.org/actions/Above-and-beyond--completing-the-World-Register-of-Marine-Species-/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Flanders Marine Institute (VLIZ)"
      },
