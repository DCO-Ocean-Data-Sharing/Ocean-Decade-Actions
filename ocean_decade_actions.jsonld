    {
      "@id": "https://purl.org/oceandecade/decadeactions/47",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Ocean effects on climate variability of the Northwest Pacific",
      "sdo:name": "Ocean effects on climate variability of the Northwest Pacific",
      "sdo:description": "The proposed program is an integrative large-scale multi-nation scientific program to enhance understanding how the climate variability in the Northwest Pacific together with remote changes in the Indian Ocean modulates regional changes in Northwest Pacific ecosystems including its marginal seas, to improve forecasts for the Northwest Pacific variability of climate and ecosystem, and to help generate solutions to mitigate climate crisis in the Northwest Pacific.",
      "sdo:location": "Republic of Korea",
      "sdo:identifier": "47",
      "sdo:url": "https://oceandecade.org/actions/Ocean-effects-on-climate-variability-of-the-Northwest-Pacific/",
