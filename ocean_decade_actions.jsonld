    {
      "@id": "https://purl.org/oceandecade/decadeactions/32.1",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "BLUE BIOCULTURE CENTER: Living Laboratory",
      "sdo:name": "BLUE BIOCULTURE CENTER: Living Laboratory",
      "sdo:description": "The Centro de Biocultura Azul is an innovative living laboratory designed to tackle environmental and socio-economic challenges in the Cabo Frio Coastal System, particularly the Araruama Lagoon. The project focuses on the sustainable cultivation of Ulva lactuca macroalgae for bioremediation, aiming to restore water quality while promoting a strong blue bioeconomy. It is structured around three interconnected pillars: environmental restoration through nutrient removal, economic development via biofertilizer production with inclusive participation from local fishing cooperatives, and social empowerment through the \"Cidadãos Azuis de Cabo Frio\" ocean education program for youth. With a projected budget of R$ 2.8 million over 36 months, the Center aligns with the UN Ocean Decade and the GEOS program, serving as a model for nature-based solutions and community-driven sustainable development.",
      "sdo:location": "Brazil",
      "sdo:identifier": "32.1",
      "sdo:url": "https://oceandecade.org/actions/blue-bioculture-center-living-laboratory/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Municipality of Cabo Frio"
      },
      "sdo:keywords": [
        {
          "@type": "sdo:DefinedTerm",
