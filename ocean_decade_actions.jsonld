      }
    },
    {
      "@id": "https://purl.org/oceandecade/decadeactions/41.8",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Advancing Big Data Technologies of Marine Life",
      "sdo:name": "Advancing Big Data Technologies of Marine Life",
      "sdo:description": "The technology for acquiring ocean-related data has steadily progressed through previous technological developments, leading to the accumulation of a vast amount of data surrounding marine ecosystems, including environmental information. To understand and advance the conservation and utilization of the complex and diverse marine ecosystems, it is important to derive new insights from big data by utilizing existing data and data acquisition technologies, including data collaboration and citizen science.  The \" Advancement of Technologies for Utilizing Big Data of Marine Life \" aims to deepen the understanding of marine ecosystems, which forms the foundation of SDG14, by utilizing marine big data. This will promote the conservation and utilization of marine organisms and ecosystems and address various ocean-related issues.",
      "sdo:location": "Japan",
      "sdo:identifier": "41.8",
      "sdo:url": "https://oceandecade.org/actions/advancing-big-data-technologies-of-marine-life/",
      "sdo:license": "https://creativecommons.org/licenses/by/4.0/",
      "sdo:parentOrganization": {
        "@type": "sdo:Organization",
        "sdo:name": "Ministry of Education, Culture, Sports, Science and Technology (MEXT)"
      },
