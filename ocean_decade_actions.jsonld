    {
      "@id": "https://purl.org/oceandecade/decadeactions/99",
      "@type": [
        "foaf:Project",
        "sdo:Project"
      ],
      "foaf:name": "Global Fishing Index",
      "sdo:name": "Global Fishing Index",
      "sdo:description": "Minderoo remains committed to protecting our seas from over-fishing and promoting sustainable wild caught fisheries at a global scale. Our work in this space continues to evolve as new technologies become available, and we are working with our partners to develop a globally-accepted measure of fish stock health to drive improved decision making and compliance.",
      "sdo:location": "Australia",
